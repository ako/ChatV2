mdl 1;

-- The product catalog in the app database (24-product-catalog.mdl): the seed
-- helpers are idempotent, so a restart never duplicates catalog data.

/**
 * @test Seeding a product twice keeps one, linked to its supplier
 * @expect $Ok = true
 */
call microflow ServiceDesk.SUB_Supplier_SeedOne(Code = 'TestSupplier', Name = 'Test supplier', Country = 'Netherlands');
call microflow ServiceDesk.SUB_Product_SeedOne(Sku = 'TST-1', Name = 'Test bike', Kind = ServiceDesk.ENUM_ProductKind.Bike, Price = 100, WarrantyYears = 2, SupplierCode = 'TestSupplier', WheelSize = '28 inch', SeatPostDiameter = empty, Brakes = empty, RackMount = true);
call microflow ServiceDesk.SUB_Product_SeedOne(Sku = 'TST-1', Name = 'Test bike again', Kind = ServiceDesk.ENUM_ProductKind.Bike, Price = 200, WarrantyYears = 2, SupplierCode = 'TestSupplier', WheelSize = empty, SeatPostDiameter = empty, Brakes = empty, RackMount = false);
retrieve $Products from ServiceDesk.Product where [Sku = 'TST-1'];
$Count = count $Products;
$Product = head $Products;
retrieve $Supplier from $Product/ServiceDesk.Product_Supplier;
declare $Ok Boolean = $Count = 1 and $Product/Name = 'Test bike' and $Supplier/Code = 'TestSupplier';
/

/**
 * @test Linking a part as compatible twice keeps one link, and a BOM line seeded twice keeps one line
 * @expect $Ok = true
 */
call microflow ServiceDesk.SUB_Product_SeedOne(Sku = 'TST-B', Name = 'Test e-bike', Kind = ServiceDesk.ENUM_ProductKind.EBike, Price = 1000, WarrantyYears = 5, SupplierCode = 'none', WheelSize = empty, SeatPostDiameter = empty, Brakes = empty, RackMount = false);
call microflow ServiceDesk.SUB_Product_SeedOne(Sku = 'TST-P', Name = 'Test battery', Kind = ServiceDesk.ENUM_ProductKind.Part, Price = 10, WarrantyYears = 2, SupplierCode = 'none', WheelSize = empty, SeatPostDiameter = empty, Brakes = empty, RackMount = false);
call microflow ServiceDesk.SUB_Product_SeedLink(FromSku = 'TST-P', ToSku = 'TST-B');
call microflow ServiceDesk.SUB_Product_SeedLink(FromSku = 'TST-P', ToSku = 'TST-B');
call microflow ServiceDesk.SUB_BomLine_SeedOne(BikeSku = 'TST-B', PartSku = 'TST-P', Quantity = 1, Role = ServiceDesk.ENUM_BomRole.Fitted);
call microflow ServiceDesk.SUB_BomLine_SeedOne(BikeSku = 'TST-B', PartSku = 'TST-P', Quantity = 1, Role = ServiceDesk.ENUM_BomRole.Fitted);
retrieve $Part from ServiceDesk.Product where [Sku = 'TST-P'] first;
retrieve $FitsOn from $Part/ServiceDesk.Product_CompatibleWith;
retrieve $Lines from ServiceDesk.BomLine where [ServiceDesk.BomLine_Bike/ServiceDesk.Product/Sku = 'TST-B'];
$FitsCount = count $FitsOn;
$LineCount = count $Lines;
declare $Ok Boolean = $FitsCount = 1 and $LineCount = 1;
/

/**
 * @test SPARQL runs inside the runtime, and the catalog dataset holds no orders while the products dataset does
 * @expect $Ok = true
 */
$Seeded = call microflow ServiceDesk.SUB_ProductCatalog_Seed();
$Catalog = call java action ServiceDesk.JA_Sparql_Query(Dataset = 'catalog', Query = 'ASK { ?o <https://example.org/bikeshop#orderNumber> ?n }');
$Products = call java action ServiceDesk.JA_Sparql_Query(Dataset = 'products', Query = 'SELECT ?sku WHERE { ?p <https://example.org/bikeshop#sku> ?sku } ORDER BY ?sku LIMIT 1');
declare $Ok Boolean = $Catalog = '{"head":{},"boolean":false}' and contains($Products, '"vars":["sku"]') and contains($Products, '"type":"literal"');
/

/**
 * @test The product tools refuse a SPARQL update and explain a malformed query
 * @expect $Ok = true
 */
$Update = call microflow ServiceDesk.Tool_Product_Sparql(Query = 'INSERT DATA { <urn:a> <urn:b> "c" }');
$Broken = call microflow ServiceDesk.Tool_Product_Sparql(Query = 'SELECT ?x WHERE { ?x }');
declare $Ok Boolean = startsWith($Update, 'Refused') and startsWith($Broken, 'Query failed');
/

/**
 * @test A bike's 3D model comes from its BOM data: mount slots, fitted and standard parts with their shapes, and what fits
 * @expect $Ok = true
 */
$Seeded = call microflow ServiceDesk.SUB_ProductCatalog_Seed();
$BomSeeded = call microflow ServiceDesk.SUB_BikeBom_Seed();
$Json = call java action ServiceDesk.JA_BikeModel_Json(Sku = 'EB-500');
$Part = call java action ServiceDesk.JA_BikeModel_Json(Sku = 'BAT-418');
declare $Ok Boolean = contains($Json, '"code":"seat_tube"') and contains($Json, '"fit":30.9')
  and contains($Json, '{"ref":"MOT-250M","label":"Mid-drive motor 250 W","role":"component","quantity":1,"slot":"bottom_bracket"')
  and contains($Json, '"ref":"SSP-31","label":"Suspension seat post 30.9 mm","role":"base"')
  and contains($Json, '"ref":"LGT-USB"') and contains($Json, '"role":"fits"') and contains($Json, '"kind":"Torus"')
  and $Part = empty;
/

/**
 * @test The catalog quality check finds nothing wrong in the seeded catalog, and reports a wiki page that names an SKU the catalog does not have
 * @expect $Ok = true
 */
$Seeded = call microflow ServiceDesk.SUB_ProductCatalog_Seed();
$BomSeeded = call microflow ServiceDesk.SUB_BikeBom_Seed();
$Page = create ServiceDesk.WikiPage (Slug = 'test-unknown-sku', Title = 'Test page', Body = 'The BAT-999 battery replaces the BAT-418.');
commit $Page;
$Found = call java action ServiceDesk.JA_Catalog_Quality();
$Errors = filter $Found where $currentObject/Severity = 'Error';
$ErrorCount = count $Errors;
$Unknown = find $Found where $currentObject/Rule = 'Unknown SKU in the wiki' and $currentObject/Sku = 'BAT-999';
$Known = find $Found where $currentObject/Rule = 'Unknown SKU in the wiki' and $currentObject/Sku = 'BAT-418';
declare $Ok Boolean = $ErrorCount = 0 and $Unknown != empty and $Known = empty and contains($Unknown/Message, 'test-unknown-sku');
/
