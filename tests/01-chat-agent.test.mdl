mdl 1;

-- Slice 01: demo data seeded by the after-startup microflow.

/**
 * @test Seeding again is a no-op once customers exist
 * @expect $Seeded = false
 */
$Seeded = call microflow ServiceDesk.SUB_SeedDemoData();
/

/**
 * @test Startup seeds five customers
 * @expect $CustomerCount = 5
 */
retrieve $Customers from ServiceDesk.Customer;
$CustomerCount = count $Customers;
/

/**
 * @test Startup seeds fifteen demo orders (the historical ones are SO-10101 and up)
 * @expect $OrderCount = 15
 */
retrieve $Orders from ServiceDesk.Order where [OrderNumber < 'SO-10100'];
$OrderCount = count $Orders;
/

/**
 * @test The demo_customer account is linked to a customer
 * @expect $LinkedName = 'Ada Jansen'
 */
retrieve $DemoUser from System.User where [Name = 'demo_customer'] first;
retrieve $Linked from ServiceDesk.Customer where [ServiceDesk.Customer_User = $DemoUser] first;
declare $LinkedName String = $Linked/Name;
/

/**
 * @test Order status tool reports status and carrier of a shipped order
 * @expect $HasShipped = true
 */
$Answer = call microflow ServiceDesk.Tool_GetOrderStatus(OrderNumber = 'SO-10002');
declare $HasShipped Boolean = contains($Answer, 'Shipped') and contains($Answer, 'DHL');
/

/**
 * @test Order status tool says so when an order does not exist
 * @expect $NotFound = true
 */
$Answer = call microflow ServiceDesk.Tool_GetOrderStatus(OrderNumber = 'SO-99999');
declare $NotFound Boolean = startsWith($Answer, 'No order found');
/

/**
 * @test Ticket search finds the double-charge ticket
 * @expect $Found = true
 */
$Answer = call microflow ServiceDesk.Tool_SearchTickets(SearchText = 'Charged twice');
declare $Found Boolean = contains($Answer, 'Charged twice');
/

/**
 * @test Create-ticket tool opens a ticket linked to the order's customer
 * @expect $LinkedName = 'Bram de Vries'
 */
$Answer = call microflow ServiceDesk.Tool_CreateTicket(Subject = 'Test ticket', Description = 'Created by a test', OrderNumber = 'SO-10004');
retrieve $Created from ServiceDesk.Ticket where [Subject = 'Test ticket'] first;
retrieve $Customer from $Created/ServiceDesk.Ticket_Customer;
declare $LinkedName String = $Customer/Name;
/

/**
 * @test Refund tool refuses an amount above the order total
 * @expect $Refused = true
 */
$Answer = call microflow ServiceDesk.Tool_IssueRefund(OrderNumber = 'SO-10004', Amount = 1000.00, Reason = 'Too much');
declare $Refused Boolean = startsWith($Answer, 'Refund not requested');
/

/**
 * @test Refund tool creates a request within the order total
 * @expect $Status = 'Requested'
 */
$Answer = call microflow ServiceDesk.Tool_IssueRefund(OrderNumber = 'SO-10012', Amount = 10.00, Reason = 'Late delivery');
retrieve $Order from ServiceDesk.Order where [OrderNumber = 'SO-10012'] first;
retrieve $Refund from ServiceDesk.RefundRequest where [ServiceDesk.RefundRequest_Order = $Order] first;
declare $Status String = getKey($Refund/Status);
/
