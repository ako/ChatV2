{
  "name": "chat-rich-text",
  "widgetName": "ChatRichText",
  "version": "1.0.0",
  "description": "Renders a chat message as markdown, with ```card blocks shown as cards. Drop-in for the Markdown viewer in Conversational UI.",
  "license": "Apache-2.0",
  "config": {
    "projectPath": "../../",
    "mendixHost": "http://localhost:8080",
    "developmentPort": 3000
  },
  "packagePath": "com.servicedesk.widgets",
  "scripts": {
    "build": "pluggable-widgets-tools release:web",
    "test": "tsc src/components/segments.ts --outDir build-test --module es2022 --target es2020 --skipLibCheck && mv build-test/segments.js build-test/segments.mjs && node --test test/segments.test.mjs"
  },
  "devDependencies": {
    "@mendix/pluggable-widgets-tools": "11.16.0",
    "@types/markdown-it": "14.1.2"
  },
  "dependencies": {
    "markdown-it": "14.1.0"
  },
  "resolutions": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "minimatch@7.0.0 - 11.0.0": "^11.0.1",
    "glob@9.0.0 - 14.0.1": "^14.0.2"
  }
