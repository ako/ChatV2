{
  "realm": "servicedesk",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "clientScopes": [
    {
      "name": "mcp:tools",
      "description": "Call the ServiceDesk MCP server's tools",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "servicedesk-mcp audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "servicedesk-mcp",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "servicedesk-mcp",
      "name": "ServiceDesk MCP server (token introspection)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-dev-introspection-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "mcp-client",
      "name": "MCP clients (Claude Code, MCP Inspector, tests)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "optionalClientScopes": [
        "mcp:tools"
      ]
    },
    {
      "clientId": "other-app",
      "name": "Another app, whose tokens the MCP server must refuse",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "users": [
    {
      "username": "demo_customer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Jansen",
      "email": "ada.jansen@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "DemoCustomer1!",
          "temporary": false
        }
      ]
    },
    {
      "username": "demo_agent",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Agent",
      "email": "agent@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "DemoAgent1234!",
          "temporary": false
        }
      ]
    }
  ]
}
