    shop:hasLine [ a shop:OrderLine ; shop:product shop:BAT-500 ; shop:quantity 1 ; shop:unitPrice 549.00 ; shop:batch "C2609" ] ,
                 [ a shop:OrderLine ; shop:product shop:CVR-500 ; shop:quantity 1 ; shop:unitPrice 11.40 ] .
shop:SO-10010 a shop:Order ; shop:orderNumber "SO-10010" ; shop:hasLine [ a shop:OrderLine ; shop:product shop:BK-100 ; shop:quantity 1 ; shop:unitPrice 899.00 ] .
shop:SO-10011 a shop:Order ; shop:orderNumber "SO-10011" ; shop:hasLine [ a shop:OrderLine ; shop:product shop:SSP-27 ; shop:quantity 1 ; shop:unitPrice 129.00 ] .
