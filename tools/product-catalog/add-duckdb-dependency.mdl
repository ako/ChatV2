mdl 1;

-- Run once on a project that does not have it yet: the module's dependency on
-- DuckDB's JDBC driver, which the runtime's SPARQL engine runs on
-- (mdlsource/25-sparql-in-runtime.mdl). A second run fails with "already
-- exists" (ako/mxcli#2239); change the version with
--   alter module "ServiceDesk" set jar dependency 'org.duckdb:duckdb_jdbc' version '<v>';
-- The extensions in resources/sparql/extensions must match its engine version.

alter module "ServiceDesk"
  add jar dependency (
    group = 'org.duckdb',
    artifact = 'duckdb_jdbc',
    version = '2.0.0.1',
    included = true,
  );
