mdl 1;

-- Chat history for both assistants (the support agent and the runtime agent on
-- OpenRouter). Opening an assistant shows the user's latest chat with it, with
-- the user's other chats beside it: pick one, start a new chat or delete one.
-- Also here, because they open this page: ACT_SupportChat_Open,
-- ACT_RuntimeChat_Open and Ticket_Overview with its floating chat.

/** A new chat for the given action microflow: the runtime agent's or the support agent's. */
create or modify microflow "ServiceDesk"."SUB_Chat_CreateNew" ($ActionMicroflow: String)
returns ConversationalUI.ChatContext as $New
folder 'Chat'
begin
  if $ActionMicroflow = 'ServiceDesk.ChatContext_RuntimeAgent_ActionMicroflow' then
    $RuntimeChat = call microflow "ServiceDesk"."SUB_RuntimeChat_Create" ();
    return $RuntimeChat;
  end if;
  $SupportChat = call microflow "ServiceDesk"."SUB_SupportChat_Create" ();
  return $SupportChat;
end;

/** A new chat with the same agent as the given chat. */
create or modify microflow "ServiceDesk"."SUB_Chat_CreateLike" ($ChatContext: ConversationalUI.ChatContext)
returns ConversationalUI.ChatContext as $New
folder 'Chat'
begin
  retrieve $ProviderConfig from $ChatContext/ConversationalUI.ChatContext_ProviderConfig_Active;
  $Created = call microflow "ServiceDesk"."SUB_Chat_CreateNew" (ActionMicroflow = $ProviderConfig/ActionMicroflow);
  return $Created;
end;

/** The current user's chats with the same agent as the given chat, most recent first. A chat with no question yet (no topic) is only listed when it is the open one. */
create or modify microflow "ServiceDesk"."DS_ChatHistory" ($ChatContext: ConversationalUI.ChatContext)
returns List of ConversationalUI.ChatContext as $History
folder 'Chat'
begin
  retrieve $ProviderConfig from $ChatContext/ConversationalUI.ChatContext_ProviderConfig_Active;
  declare $ActionMicroflow String = $ProviderConfig/ActionMicroflow;
  retrieve $History from ConversationalUI.ChatContext where [System.owner = $currentUser][ConversationalUI.ChatContext_ProviderConfig_Active/ConversationalUI.ProviderConfig/ActionMicroflow = $ActionMicroflow][Topic != empty or id = $ChatContext] sort by changedDate desc;
  return $History;
end;

/** Opens a chat from the history. */
create or modify microflow "ServiceDesk"."ACT_Chat_Show" ($ChatContext: ConversationalUI.ChatContext)
folder 'Chat'
begin
  show page "ServiceDesk"."Chat_WithHistory" (ChatContext = $ChatContext);
end;

/** Starts a new chat with the same agent as the open one. Does nothing when the open chat has no question yet. */
create or modify microflow "ServiceDesk"."ACT_Chat_New" ($ChatContext: ConversationalUI.ChatContext)
folder 'Chat'
begin
  if $ChatContext/Topic = empty or trim($ChatContext/Topic) = '' then
    return;
  end if;
  $New = call microflow "ServiceDesk"."SUB_Chat_CreateLike" (ChatContext = $ChatContext);
  if $New = empty then
    return;
  end if;
  show page "ServiceDesk"."Chat_WithHistory" (ChatContext = $New);
end;

/** Deletes a chat and returns the chat to show next: the open chat when another chat was deleted; otherwise the most recent remaining chat with the same agent, or a new one. */
create or modify microflow "ServiceDesk"."SUB_Chat_Delete" ($ChatContext: ConversationalUI.ChatContext, $OpenChat: ConversationalUI.ChatContext)
returns ConversationalUI.ChatContext as $Next
folder 'Chat'
begin
  if $ChatContext != $OpenChat then
    call microflow ConversationalUI.ChatContext_Delete(ChatContext = $ChatContext);
    return $OpenChat;
  end if;
  retrieve $ProviderConfig from $ChatContext/ConversationalUI.ChatContext_ProviderConfig_Active;
  declare $ActionMicroflow String = $ProviderConfig/ActionMicroflow;
  call microflow ConversationalUI.ChatContext_Delete(ChatContext = $ChatContext);
  $Latest = call microflow "ServiceDesk"."SUB_Chat_GetLatest" (ActionMicroflow = $ActionMicroflow);
  if $Latest != empty then
    return $Latest;
  end if;
  $New = call microflow "ServiceDesk"."SUB_Chat_CreateNew" (ActionMicroflow = $ActionMicroflow);
  return $New;
end;

/** Delete button in the chat history: deletes the chat and shows the next one. */
create or modify microflow "ServiceDesk"."ACT_Chat_Delete" ($ChatContext: ConversationalUI.ChatContext, $OpenChat: ConversationalUI.ChatContext)
folder 'Chat'
begin
  $Next = call microflow "ServiceDesk"."SUB_Chat_Delete" (ChatContext = $ChatContext, OpenChat = $OpenChat);
  if $Next = empty then
    return;
  end if;
  show page "ServiceDesk"."Chat_WithHistory" (ChatContext = $Next);
end;

/** Opens the support agent chat with the chat history: the latest chat, or a new one. */
create or modify microflow "ServiceDesk"."ACT_SupportChat_Open" ()
folder 'Chat'
begin
  $ChatContext = call microflow "ServiceDesk"."SUB_SupportChat_GetOrCreate" ();
  if $ChatContext = empty then
    return;
  end if;
  show page "ServiceDesk"."Chat_WithHistory" (ChatContext = $ChatContext);
end;

/** Opens the runtime support agent (OpenRouter) chat with the chat history: the latest chat, or a new one. */
create or modify microflow "ServiceDesk"."ACT_RuntimeChat_Open" ()
folder 'Runtime agent'
begin
  $ChatContext = call microflow "ServiceDesk"."SUB_RuntimeChat_GetOrCreate" ();
  if $ChatContext = empty then
    return;
  end if;
  show page "ServiceDesk"."Chat_WithHistory" (ChatContext = $ChatContext);
end;

/** A chat in three columns: the user's chats, the conversation, and a details panel. Staff see metrics, tool calls and context in the panel; a customer sees the orders the chat is about. Used by both assistants. */
create or modify page "ServiceDesk"."Chat_WithHistory" folder 'Chat'
(
  params: ( $ChatContext: ConversationalUI.ChatContext ),
  title: 'Assistant',
  layout: Atlas_Core.Atlas_Default
)
{
  container ctChatShell (Class: 'sd-chat-shell') {
    container ctChatList (Class: 'sd-panel sd-chat-list') {
      actionbutton btnNewChat (caption: 'New chat', action: call microflow "ServiceDesk"."ACT_Chat_New"(ChatContext = $ChatContext), buttonstyle: primary, icon: Atlas_Core.Atlas."message-bubble-add", Class: 'sd-new-chat')
      dynamictext txtHistory (content: 'Your chats', Class: 'sd-eyebrow')
      listview lvHistory (Class: 'sd-chat-history', datasource: microflow "ServiceDesk"."DS_ChatHistory"(ChatContext = $ChatContext)) {
        container ctHistoryItem (Class: 'sd-chat-item', DynamicClasses: if $currentObject = $ChatContext then 'sd-chat-item--active' else '') {
          container ctOpenChat (OnClick: call microflow "ServiceDesk"."ACT_Chat_Show"(ChatContext = $currentObject), Class: 'sd-chat-item__open') {
            dynamictext txtTopic (content: '{1}', contentparams: ({1} = Topic), Class: 'sd-chat-item__topic', Visible: $currentObject/Topic != empty)
            dynamictext txtNewChat (content: 'New chat', Class: 'sd-chat-item__topic', Visible: $currentObject/Topic = empty)
          }
          actionbutton btnDeleteChat (Tooltip: 'Delete chat', action: call microflow "ServiceDesk"."ACT_Chat_Delete"(ChatContext = $currentObject, OpenChat = $ChatContext) with (Confirmation: 'Delete this chat?', ProceedCaption: 'Delete', CancelCaption: 'Cancel'), icon: glyph 57376, Class: 'btn-image sd-chat-item__delete')
        }
      }
    }
    container ctConversation (Class: 'sd-panel sd-conversation') {
      dataview dvChat (datasource: $ChatContext, Class: 'chat-dataview--display-contents') {
        container ctChat (Class: 'chat-container sd-chat-card') {
          snippetcall scChat (snippet: ConversationalUI.Snippet_ChatContext_ConversationalUI)
        }
        -- tools inside the message box: add a photo (22b-chat-photos.mdl), talk to a person (07b-chat-handoff.mdl) and speak;
        -- the companion also refreshes the chat every few seconds, so a support agent's reply or a delay notice shows up
        container ctComposeTools (Class: 'sd-compose-tools') {
          actionbutton btnAddPhoto (Tooltip: 'Add a photo', action: call microflow "ServiceDesk"."ACT_ChatPhoto_New"(ChatContext = $ChatContext), icon: Atlas_Core.Atlas.camera, Class: 'sd-compose-btn')
          actionbutton btnTalkToPerson (Tooltip: 'Talk to a person', action: call microflow "ServiceDesk"."ACT_Handoff_Request"(ChatContext = $ChatContext), icon: Atlas_Core.Atlas."headphones-mic", Class: 'sd-compose-btn')
          pluggablewidget 'com.servicedesk.widgets.chatcompanion.ChatCompanion' ccVoice ( voiceInput: true, refreshAction: microflow "ServiceDesk"."ACT_Chat_LiveRefresh" (ChatContext = $ChatContext), refreshSeconds: 5 )
        }
      }
    }
    container ctDetails (Class: 'sd-panel sd-details') {
      dataview dvDetails (datasource: microflow "ServiceDesk"."DS_ChatDetails"(ChatContext = $ChatContext), Class: 'sd-details__view') {
        container ctDetailsHead (Class: 'sd-details__head') {
          dynamictext txtDetails (content: 'Details', Class: 'sd-details__title')
          actionbutton btnRefreshDetails (Tooltip: 'Refresh the details', action: call microflow "ServiceDesk"."ACT_Chat_Show"(ChatContext = $ChatContext), icon: Atlas_Core.Atlas.refresh, Class: 'btn-image sd-details__refresh')
        }
        tabcontainer tcDetails (Class: 'sd-tabs', Visible: $currentObject/IsStaff) {
          tabpage tpMetrics (Caption: 'Metrics') {
            pluggablewidget 'com.servicedesk.widgets.chatrichtext.ChatRichText' crtMetrics ( stringAttribute: Metrics )
          }
          tabpage tpToolCalls (Caption: 'Tool calls') {
            pluggablewidget 'com.servicedesk.widgets.chatrichtext.ChatRichText' crtToolCalls ( stringAttribute: ToolCalls )
          }
          tabpage tpContext (Caption: 'Context') {
            pluggablewidget 'com.servicedesk.widgets.chatrichtext.ChatRichText' crtContext ( stringAttribute: ContextText )
          }
        }
        container ctCustomerContext (Class: 'sd-details__body', Visible: not($currentObject/IsStaff)) {
          pluggablewidget 'com.servicedesk.widgets.chatrichtext.ChatRichText' crtCustomerContext ( stringAttribute: ContextText )
        }
      }
    }
  }
};

/** Tickets: all of them for staff, only their own for a customer, with the floating chat button. */
create or modify page "ServiceDesk"."Ticket_Overview" folder 'Tickets'
(
  title: 'Tickets',
  layout: Atlas_Core.Atlas_Default,
  url: 'tickets'
)
{
  layoutgrid lgMain {
    row {
      column (desktopwidth: 12) {
        dynamictext txtHeading (content: 'Tickets', rendermode: H2)
        actionbutton btnNew (caption: 'New ticket', action: create object "ServiceDesk"."Ticket" then show page "ServiceDesk"."Ticket_NewEdit", buttonstyle: primary)
        actionbutton btnChat (caption: 'Ask the assistant', action: call microflow "ServiceDesk"."ACT_SupportChat_Open")
        datagrid dgTickets (
          datasource: database from "ServiceDesk"."Ticket" sort by "TicketNumber" desc,
          PagingPosition: bottom,
          designproperties: ('Hover': on, 'Striped': on)
        ) {
          column (attribute: "TicketNumber", caption: '#') { numberfilter nfNumber }
          column (attribute: "Subject", caption: 'Subject') { textfilter tfSubject }
          column (attribute: Ticket_Customer/"Name", caption: 'Customer')
          column (attribute: "Category", caption: 'Category') { dropdownfilter ddCategory }
          column (attribute: "Priority", caption: 'Priority') { dropdownfilter ddPriority }
          column (attribute: "Status", caption: 'Status') { dropdownfilter ddStatus }
          column (caption: '') {
            actionbutton btnOpen (caption: 'Open', action: show page "ServiceDesk"."Ticket_NewEdit"("Ticket" = $currentObject))
          }
        }
        dataview dvChat (datasource: microflow "ServiceDesk"."DS_SupportChat") {
          snippetcall scFloatingChat (snippet: ConversationalUI.Snippet_FloatingChatButton, params: (ChatContext = $currentObject))
        }
      }
    }
  }
};

grant execute on microflow "ServiceDesk"."ACT_SupportChat_Open" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
grant execute on microflow "ServiceDesk"."DS_ChatHistory" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
grant execute on microflow "ServiceDesk"."ACT_Chat_Show" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
grant execute on microflow "ServiceDesk"."ACT_Chat_New" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
grant execute on microflow "ServiceDesk"."ACT_Chat_Delete" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
grant view on page "ServiceDesk"."Chat_WithHistory" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
grant execute on microflow "ServiceDesk"."ACT_RuntimeChat_Open" to "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
grant view on page "ServiceDesk"."Ticket_Overview" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
