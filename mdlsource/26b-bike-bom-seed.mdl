/** Seeds the mount slots, BOM lines and part models unless there are BOM lines already. Generated. */
create or modify microflow "ServiceDesk"."SUB_BikeBom_Seed" ()
returns Boolean as $Seeded
folder 'Bike BOM'
begin
  retrieve $Any from "ServiceDesk"."BomLine" first;
  if $Any != empty then
    return false;
  end if;
  call microflow "ServiceDesk"."SUB_BikeBom_Seed_1" ();
  call microflow "ServiceDesk"."SUB_BikeBom_Seed_2" ();
  call microflow "ServiceDesk"."SUB_BikeBom_Seed_3" ();
  call microflow "ServiceDesk"."SUB_BikeBom_Seed_4" ();
  call microflow "ServiceDesk"."SUB_BikeBom_Seed_5" ();
  log info node 'ServiceDesk' 'Seeded the bikes'' mount slots, BOM and part models.';
  return true;
end;
