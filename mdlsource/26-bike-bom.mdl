mdl 1;

-- The bikes' bill of materials and 3D specs, stored in the app.
--
-- MOUNT SLOTS are named points on a bike's frame (down tube, rear hub, seat
-- tube...), with a fit size where one matters (the seat tube's diameter). BOM
-- LINES say what a bike is built with: fitted parts it ships with (the graph's
-- "has component") and standard parts (tyres, tubes, brakes, seat post). A PART
-- MODEL says where a part mounts, the fit size it needs, which way it moves when
-- the bike is exploded, and its shape as simple primitives (SHAPE PARTS) placed
-- relative to the slot: metres, degrees, side view in the XY plane.
--
-- The 3D viewer assembles a bike from this data (GET rest/productgraph/v1/models/{ref},
-- JA_BikeModel_Json), so a new part needs data, not code. A part a bike cannot take
-- (no such mount, another fit size) is listed under the viewer with the reason.
-- The seed (26b-bike-bom-seed.mdl) is generated by tools/product-catalog/bike_models.py.

/** What a BOM line is: fitted (the bike ships with it) or standard (tyres, tubes, brakes, seat post). */
create or modify enumeration "ServiceDesk"."ENUM_BomRole" (
  "Fitted" 'Fitted',
  "Standard" 'Standard'
);

/** The primitive a shape part is drawn as. */
create or modify enumeration "ServiceDesk"."ENUM_ShapeKind" (
  "Box" 'Box',
  "Cylinder" 'Cylinder',
  "Torus" 'Torus',
  "Dome" 'Dome'
);

/** The surface of a shape part. */
create or modify enumeration "ServiceDesk"."ENUM_ShapeFinish" (
  "Matte" 'Matte',
  "Metal" 'Metal',
  "Rubber" 'Rubber'
);

/** A named point on a bike's frame where parts mount, with a fit size (mm) where one matters. Position in metres. */
create or modify persistent entity "ServiceDesk"."MountSlot" (
  "Code": String(40) not null error message 'Enter a code.',
  "Name": String(100),
  "X": Decimal,
  "Y": Decimal,
  "Z": Decimal,
  "FitDiameterMm": Decimal,
  "ChangedDate": AutoChangedDate,
  "ChangedBy": AutoChangedBy
);

/** One line of a bike's bill of materials. */
create or modify persistent entity "ServiceDesk"."BomLine" (
  "Quantity": Integer default 1,
  "Role": Enumeration(ServiceDesk.ENUM_BomRole) default ServiceDesk.ENUM_BomRole.Fitted,
  "ChangedDate": AutoChangedDate,
  "ChangedBy": AutoChangedBy
);

/** How a part is drawn and where it mounts: the slot code, the fit size it needs (mm), and its explode direction. */
create or modify persistent entity "ServiceDesk"."PartModel" (
  "MountsAt": String(40),
  "FitDiameterMm": Decimal,
  "ExplodeX": Decimal,
  "ExplodeY": Decimal,
  "ExplodeZ": Decimal,
  "PreviewBikeSku": String(30),
  "ModelVersion": Integer default 0,
  "ChangedDate": AutoChangedDate,
  "ChangedBy": AutoChangedBy
);

/** One primitive of a part's shape, relative to its mount slot. Size: Box w h d; Cylinder top radius, bottom radius, length; Torus radius, tube; Dome radius. Segments and Detail set the roundness. */
create or modify persistent entity "ServiceDesk"."ShapePart" (
  "Seq": Integer,
  "Kind": Enumeration(ServiceDesk.ENUM_ShapeKind),
  "Finish": Enumeration(ServiceDesk.ENUM_ShapeFinish) default ServiceDesk.ENUM_ShapeFinish.Matte,
  "Color": String(9),
  "Emissive": String(9),
  "Glow": Decimal,
  "Opacity": Decimal default 1,
  "Wireframe": Boolean default false,
  "X": Decimal,
  "Y": Decimal,
  "Z": Decimal,
  "SizeA": Decimal,
  "SizeB": Decimal,
  "SizeC": Decimal,
  "RotX": Decimal,
  "RotY": Decimal,
  "RotZ": Decimal,
  "Segments": Integer,
  "Detail": Integer,
  "ChangedDate": AutoChangedDate,
  "ChangedBy": AutoChangedBy
);

/** The bike a mount slot is on. */
create or modify association "ServiceDesk"."MountSlot_Product" from "ServiceDesk"."MountSlot" to "ServiceDesk"."Product" on delete cascade;
/** The bike a BOM line belongs to. */
create or modify association "ServiceDesk"."BomLine_Bike" from "ServiceDesk"."BomLine" to "ServiceDesk"."Product" on delete cascade;
/** The part on a BOM line. */
create or modify association "ServiceDesk"."BomLine_Part" from "ServiceDesk"."BomLine" to "ServiceDesk"."Product";
/** The part a part model draws. */
create or modify association "ServiceDesk"."PartModel_Product" from "ServiceDesk"."PartModel" to "ServiceDesk"."Product" on delete cascade;
/** The part model a shape part belongs to. */
create or modify association "ServiceDesk"."ShapePart_PartModel" from "ServiceDesk"."ShapePart" to "ServiceDesk"."PartModel" on delete cascade;

grant read * on entity "ServiceDesk"."MountSlot" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
grant read * on entity "ServiceDesk"."BomLine" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
grant read * on entity "ServiceDesk"."PartModel" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
grant read * on entity "ServiceDesk"."ShapePart" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";

/** Seed helper: a mount slot on a bike, unless the bike has one with that code. */
create or modify microflow "ServiceDesk"."SUB_MountSlot_SeedOne" ($BikeSku: String, $Code: String, $Name: String, $X: Decimal, $Y: Decimal, $Z: Decimal, $FitDiameterMm: Decimal)
folder 'Bike BOM'
begin
  retrieve $Bike from "ServiceDesk"."Product" where [Sku = $BikeSku] first;
  if $Bike = empty then
    return;
  end if;
  retrieve $Existing from "ServiceDesk"."MountSlot" where ["ServiceDesk"."MountSlot_Product" = $Bike][Code = $Code] first;
  if $Existing = empty then
    $Slot = create "ServiceDesk"."MountSlot" ("Code" = $Code, "Name" = $Name, "X" = $X, "Y" = $Y, "Z" = $Z, "FitDiameterMm" = $FitDiameterMm, "ServiceDesk"."MountSlot_Product" = $Bike) commit;
  end if;
end;

/** Seed helper: a BOM line, unless the bike already has a line for that part. */
create or modify microflow "ServiceDesk"."SUB_BomLine_SeedOne" ($BikeSku: String, $PartSku: String, $Quantity: Integer, $Role: Enumeration(ServiceDesk.ENUM_BomRole))
folder 'Bike BOM'
begin
  retrieve $Bike from "ServiceDesk"."Product" where [Sku = $BikeSku] first;
  retrieve $Part from "ServiceDesk"."Product" where [Sku = $PartSku] first;
  if $Bike = empty or $Part = empty then
    log warning node 'ServiceDesk' 'BOM seed: no product {1} or {2}.' with ({1} = $BikeSku, {2} = $PartSku);
    return;
  end if;
  retrieve $Existing from "ServiceDesk"."BomLine" where ["ServiceDesk"."BomLine_Bike" = $Bike]["ServiceDesk"."BomLine_Part" = $Part] first;
  if $Existing = empty then
    $Line = create "ServiceDesk"."BomLine" ("Quantity" = $Quantity, "Role" = $Role, "ServiceDesk"."BomLine_Bike" = $Bike, "ServiceDesk"."BomLine_Part" = $Part) commit;
  end if;
end;

/** Seed helper: a part's model (where it mounts, its fit size and explode direction), unless it has one. */
create or modify microflow "ServiceDesk"."SUB_PartModel_SeedOne" ($Sku: String, $MountsAt: String, $FitDiameterMm: Decimal, $ExplodeX: Decimal, $ExplodeY: Decimal, $ExplodeZ: Decimal)
folder 'Bike BOM'
begin
  retrieve $Part from "ServiceDesk"."Product" where [Sku = $Sku] first;
  if $Part = empty then
    return;
  end if;
  retrieve $Existing from "ServiceDesk"."PartModel" where ["ServiceDesk"."PartModel_Product" = $Part] first;
  if $Existing = empty then
    $Model = create "ServiceDesk"."PartModel" ("MountsAt" = $MountsAt, "FitDiameterMm" = $FitDiameterMm, "ExplodeX" = $ExplodeX, "ExplodeY" = $ExplodeY, "ExplodeZ" = $ExplodeZ, "ServiceDesk"."PartModel_Product" = $Part) commit;
  end if;
end;

/** Seed helper: one shape part of a part's model, unless it has one with that sequence number. */
create or modify microflow "ServiceDesk"."SUB_ShapePart_SeedOne" ($Sku: String, $Seq: Integer, $Kind: Enumeration(ServiceDesk.ENUM_ShapeKind), $Finish: Enumeration(ServiceDesk.ENUM_ShapeFinish), $Color: String, $Emissive: String, $Glow: Decimal, $Opacity: Decimal, $Wireframe: Boolean, $X: Decimal, $Y: Decimal, $Z: Decimal, $SizeA: Decimal, $SizeB: Decimal, $SizeC: Decimal, $RotX: Decimal, $RotY: Decimal, $RotZ: Decimal, $Segments: Integer, $Detail: Integer)
folder 'Bike BOM'
begin
  retrieve $Model from "ServiceDesk"."PartModel" where ["ServiceDesk"."PartModel_Product"/"ServiceDesk"."Product"/Sku = $Sku] first;
  if $Model = empty then
    return;
  end if;
  retrieve $Existing from "ServiceDesk"."ShapePart" where ["ServiceDesk"."ShapePart_PartModel" = $Model][Seq = $Seq] first;
  if $Existing = empty then
    $Shape = create "ServiceDesk"."ShapePart" ("Seq" = $Seq, "Kind" = $Kind, "Finish" = $Finish, "Color" = $Color, "Emissive" = $Emissive, "Glow" = $Glow, "Opacity" = $Opacity, "Wireframe" = $Wireframe,
      "X" = $X, "Y" = $Y, "Z" = $Z, "SizeA" = $SizeA, "SizeB" = $SizeB, "SizeC" = $SizeC, "RotX" = $RotX, "RotY" = $RotY, "RotZ" = $RotZ, "Segments" = $Segments, "Detail" = $Detail,
      "ServiceDesk"."ShapePart_PartModel" = $Model) commit;
  end if;
end;

/** A bike as the 3D viewer draws it, as JSON: its mount slots and the parts that can appear on it (BOM lines and compatible parts), each with its model and shapes. Empty when there is no such bike or it has no mount slots. Read with the user's own access. */
create or modify java action "ServiceDesk"."JA_BikeModel_Json" folder 'Bike BOM' (
  /** The bike's SKU, e.g. EB-200. */
  Sku: String
) returns String as $Json
not exposed
as $$
return servicedesk.graph.BikeModels.json(getContext(), this.Sku);
$$;

/** GET rest/productgraph/v1/models/{ref}: the bike's 3D model data for the viewer; 404 for a product that is not a bike with mount slots. */
create or modify microflow "ServiceDesk"."REST_GetBikeModel" ($ref: String, $httpResponse: System.HttpResponse)
returns String as $Json
folder 'Bike BOM'
begin
  $Json = call java action "ServiceDesk"."JA_BikeModel_Json" (Sku = (if $ref = empty then '' else trim($ref))) on error without rollback begin
    log warning node 'ServiceDesk' '3D model of {1} not built: {2}' with ({1} = (if $ref = empty then '' else $ref), {2} = $latestError/Message);
    change $httpResponse ("StatusCode" = 500);
    return 'The 3D model could not be built right now.';
  end error;
  if $Json = empty then
    change $httpResponse ("StatusCode" = 404);
    return 'No 3D model: ' + (if $ref = empty then '' else $ref) + ' is not a bike with mount points.';
  end if;
  $Header = create System.HttpHeader ("Key" = 'Content-Type', "Value" = 'application/json', System.HttpHeaders = $httpResponse);
  return $Json;
end;

grant execute on microflow "ServiceDesk"."REST_GetBikeModel" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
