mdl 1;

-- The app shell: the after-startup microflow and the navigation menu. They
-- reference documents from every other script, so this script runs last.

/** Configures the OpenAI-compatible endpoint and seeds the runtime agent. Optional: a failure (no encryption key, as in the test runtime) is logged and does not stop the app from starting. */
create or modify microflow "ServiceDesk"."SUB_SetUpRuntimeAgent" ()
returns Boolean as $Ready
folder 'Setup'
begin
  $OpenRouterModel = call microflow "ServiceDesk"."ASU_ConfigureOpenAICompatible" () on error without rollback begin
    log warning node 'ServiceDesk' 'OpenAI-compatible endpoint not configured: {1}' with ({1} = $latestError/Message);
    return false;
  end error;
  $RuntimeAgent = call microflow "ServiceDesk"."ASU_SeedRuntimeAgent" () on error without rollback begin
    log warning node 'ServiceDesk' 'Runtime agent not created: {1}' with ({1} = $latestError/Message);
    return false;
  end error;
  $CardFormatAdded = call microflow "ServiceDesk"."SUB_RuntimeAgent_EnsureCardFormat" (Agent = $RuntimeAgent);
  $PgVectorReady = call microflow "ServiceDesk"."ASU_ConfigurePgVector" () on error without rollback begin
    log warning node 'ServiceDesk' 'PgVector knowledge base not configured: {1}' with ({1} = $latestError/Message);
    return true;
  end error;
  if $PgVectorReady then
    $PoliciesAttached = call microflow "ServiceDesk"."SUB_RuntimeAgent_AttachPolicies" (Agent = $RuntimeAgent);
  end if;
  return true;
end;

/** After-startup microflow: loads the Agent Editor documents into Agent Commons, seeds demo data, syncs shipments from the carrier and reloads the product graph snapshot, starts the MCP servers, then sets up the runtime agent on the OpenAI-compatible endpoint seeds the free models' price and the places for map cards. */
create or modify microflow "ServiceDesk"."ASU_App" ()
returns Boolean as $Started
folder 'Setup'
begin
  $AgentsLoaded = call microflow AgentEditorCommons.ASU_AgentEditor ();
  $Seeded = call microflow "ServiceDesk"."SUB_SeedDemoData" ();
  call microflow "ServiceDesk"."SUB_SeedOrderHistory" ();
  $ShipmentsSynced = call microflow "ServiceDesk"."SUB_Shipments_Sync" ();
  $GraphLoaded = call microflow "ServiceDesk"."SUB_ProductGraph_Load" ();
  $McpStarted = call microflow "ServiceDesk"."MCP_Initialize" ();
  $RuntimeAgentReady = call microflow "ServiceDesk"."SUB_SetUpRuntimeAgent" ();
  $PricesSeeded = call microflow "ServiceDesk"."SUB_ModelPrice_Seed" ();
  $PlacesSeeded = call microflow "ServiceDesk"."SUB_Place_Seed" ();
  return true;
end;

alter settings runtime ( AfterStartupMicroflow: 'ServiceDesk.ASU_App' );

/** Landing page for every role: what the app does, the assistant first, and a tile per area. Mendix hides a tile whose page or microflow the user may not open, so customers see their own areas only. Defined here, last, because it links to pages from every other script. */
create or modify page "ServiceDesk"."Home" folder 'Home'
(
  title: 'Service Desk Copilot',
  layout: Atlas_Core.Atlas_Default,
  url: 'home'
)
{
  container ctHome (Class: 'sd-home') {
    container ctHero (Class: 'sd-panel sd-hero') {
      dynamictext txtEyebrow (content: 'Service desk', Class: 'sd-eyebrow')
      dynamictext txtHeading (content: 'How can we help today?', rendermode: H1, Class: 'sd-hero__title')
      dynamictext txtIntro (content: 'Ask the assistant about an order, a parcel, a product or a return. It looks things up in the shop''s own data, and a support agent steps in when a person is needed.', Class: 'sd-hero__intro')
      actionbutton btnAskAssistant (caption: 'Ask the assistant', action: call microflow "ServiceDesk"."ACT_SupportChat_Open", buttonstyle: primary, icon: Atlas_Core.Atlas."message-bubble", Class: 'sd-hero__cta')
    }
    container ctTiles (Class: 'sd-tiles') {
      actionbutton btnTileTickets (caption: 'Tickets', action: show page "ServiceDesk"."Ticket_Overview", icon: Atlas_Core.Atlas.tag, Class: 'sd-tile')
      actionbutton btnTileOrders (caption: 'Orders', action: show page "ServiceDesk"."Order_Overview", icon: Atlas_Core.Atlas."shopping-cart", Class: 'sd-tile')
      actionbutton btnTileReturns (caption: 'Returns', action: show page "ServiceDesk"."Return_Overview", icon: Atlas_Core.Atlas."arrow-circle-left", Class: 'sd-tile')
      actionbutton btnTileTasks (caption: 'My tasks', action: show page "ServiceDesk"."WF_TaskInbox", icon: Atlas_Core.Atlas."checkmark-circle", Class: 'sd-tile')
      actionbutton btnTileDashboard (caption: 'Dashboard', action: show page "ServiceDesk"."Dashboard", icon: Atlas_Core.Atlas."analytics-bars", Class: 'sd-tile')
      actionbutton btnTileExplorer (caption: 'Product explorer', action: show page "ServiceDesk"."ProductGraph_Explorer", icon: Atlas_Core.Atlas."share-arrow", Class: 'sd-tile')
    }
  }
};

grant view on page "ServiceDesk"."Home" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";

create or modify navigation Responsive
  app title 'Service Desk Copilot'
  app icon Atlas_Core.Content.Mendix
  home page "ServiceDesk"."Home"
{
  menu item 'Home' ( OnClick: show page "ServiceDesk"."Home", Icon: Atlas_Core.Atlas.home )
  menu item 'Assistant' ( OnClick: call microflow "ServiceDesk"."ACT_SupportChat_Open", Icon: Atlas_Core.Atlas."message-bubble" )
  menu item 'Assistant (OpenRouter)' ( OnClick: call microflow "ServiceDesk"."ACT_RuntimeChat_Open", Icon: Atlas_Core.Atlas."message-bubble-add" )
  menu item 'Dashboard' ( OnClick: show page "ServiceDesk"."Dashboard", Icon: Atlas_Core.Atlas."analytics-bars" )
  menu item 'My tasks' ( OnClick: show page "ServiceDesk"."WF_TaskInbox", Icon: Atlas_Core.Atlas."checkmark-circle" )
  menu item 'Tickets' ( OnClick: show page "ServiceDesk"."Ticket_Overview", Icon: Atlas_Core.Atlas.tag )
  menu item 'Orders' ( OnClick: show page "ServiceDesk"."Order_Overview", Icon: Atlas_Core.Atlas."shopping-cart" )
  menu item 'Returns' ( OnClick: show page "ServiceDesk"."Return_Overview", Icon: Atlas_Core.Atlas."arrow-circle-left" )
  menu item 'Refund requests' ( OnClick: show page "ServiceDesk"."RefundRequest_Overview", Icon: Atlas_Core.Atlas.euro )
  menu item 'Customers' ( OnClick: show page "ServiceDesk"."Customer_Overview", Icon: Atlas_Core.Atlas."user-neutral-group" )
  menu item 'Policy documents' ( OnClick: show page "ServiceDesk"."PolicyDocument_Overview", Icon: Atlas_Core.Atlas.document )
  menu item 'Product explorer' ( OnClick: show page "ServiceDesk"."ProductGraph_Explorer", Icon: Atlas_Core.Atlas."share-arrow" )
  menu item 'Product graph' ( OnClick: call microflow "ServiceDesk"."ACT_ProductGraph_Open", Icon: Atlas_Core.Atlas."hierarchy-files" )
  menu item 'Token usage' ( OnClick: call microflow ConversationalUI.NAV_TokenConsumptionMonitor, Icon: Atlas_Core.Atlas.dashboard )
  menu item 'Traces' ( OnClick: show page ConversationalUI.Trace_Overview, Icon: Atlas_Core.Atlas.search )
  menu item 'Service appointments' ( OnClick: show page "ServiceDesk"."ServiceAppointment_Overview", Icon: Atlas_Core.Atlas.dashboard )
  menu item 'Answer ratings' ( OnClick: show page "ServiceDesk"."AnswerRating_Overview", Icon: Atlas_Core.Atlas."checkmark-circle" )
  menu item 'Model prices' ( OnClick: show page "ServiceDesk"."ModelPrice_Overview", Icon: Atlas_Core.Atlas.euro )
  menu item 'Agents' ( OnClick: show page AgentCommons.Agent_Overview, Icon: Atlas_Core.Atlas.cog )
};
