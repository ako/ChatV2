mdl 1;

-- Agent Editor documents: the Mendix Cloud GenAI model and knowledge base,
-- the conversational support agent and the triage and document task agents.
-- Key constants carry no value in the model; pass them per run, e.g.
--   --constant ServiceDesk.MxGenAIKey=@env:GENAI_TEXT_KEY
-- Everything is written here, including tool approval and streaming
-- (ako/mxcli#2037, #2038), each agent's selected model (#2031) and the
-- consumed MCP services' endpoints (#2060). That needs an mxcli built from
-- main after 2026-11-10 13:45 UTC, or a nightly from 2026-11-11 on; an older
-- one rejects SelectedModel and Endpoint.

/** Mendix Cloud GenAI text generation key. Never commit a value; pass it per run or per environment. */
create or modify constant "ServiceDesk"."MxGenAIKey" folder 'Agents' (
  Type: String,
  DefaultValue: ''
);

/** Mendix Cloud GenAI knowledge base key. Never commit a value; pass it per run or per environment. */
create or modify constant "ServiceDesk"."MxGenAIKnowledgeBaseKey" folder 'Agents' (
  Type: String,
  DefaultValue: ''
);

/** URL of the external parcel-tracking MCP server (tools/carrier-mcp). */
create or modify constant "ServiceDesk"."CarrierMcpEndpoint" folder 'Agents' (
  Type: String,
  DefaultValue: 'http://127.0.0.1:8765/mcp'
);

/** External MCP server of the parcel carrier: track_parcel, list_carriers. */
create or modify consumed mcp service "ServiceDesk"."CarrierTracking" folder 'Agents' (
  ProtocolVersion: v2025_03_26,
  Endpoint: @"ServiceDesk"."CarrierMcpEndpoint",
  Version: '1.0.0',
  ConnectionTimeoutSeconds: 30,
  Documentation: 'Parcel tracking for PostNL, DHL and UPS (tools/carrier-mcp).'
);

create or modify ai model "ServiceDesk"."SupportModel" folder 'Agents' (
  Provider: MxCloudGenAI,
  Key: @"ServiceDesk"."MxGenAIKey"
);

create or modify knowledge base "ServiceDesk"."PolicyKnowledgeBase" folder 'Agents' (
  Provider: MxCloudGenAI,
  Key: @"ServiceDesk"."MxGenAIKnowledgeBaseKey"
);

/** Chat agent for customers and service-desk staff. */
create or modify agent "ServiceDesk"."SupportAgent" folder 'Agents' (
  UsageType: Chat,
  Model: "ServiceDesk"."SupportModel",
  SelectedModel: 'eu.anthropic.claude-sonnet-5-5',
  Description: 'Answers questions about orders and tickets, opens tickets and requests refunds after the user approves.',
  ToolChoice: Auto,
  EnableBackendStreaming: true,
  EnableUIStreaming: true,
  SystemPrompt: $$You are the service-desk assistant of a web shop. You help customers and support staff with orders, tickets and refunds.

Tools:
- GetOrderStatus: look up an order by its number (format SO-10001). Use it whenever someone asks where an order is, when it ships or what it cost.
- SearchTickets: find existing tickets by a word or phrase from the subject or description.
- CreateTicket: open a new ticket for an order. Only do this after you have a clear subject, a short description and the order number. The user is asked to approve it.
- TriageTicket: have the triage agent classify an existing ticket by its number, when someone asks how urgent a ticket is or what it is about.
- GetDeliveryStatistics: how long delivered orders took from order to delivery, and where the time went: per leg (warehouse, to the hub, at the hub, last mile), per hub and per carrier. A customer gets their own orders, staff get all. Use it for "on average how long did my orders take" and "where is most time spent delivering parcels". Never compute averages yourself; report the tool's numbers.
- track_parcel (carrier tracking service): the scan history of a parcel by its tracking code. Use it after GetOrderStatus when someone asks where a parcel is or why it is late.
- RequestReturn: start a return for an item of a delivered order (inputs: order number, the item, the customer's reason in their words). Look the item up yourself with GetOrderProducts and pass its SKU and name; never ask the customer for a SKU. When the product graph has no contents for the order, pass the item as the customer names it (the return check and a support agent verify it). Ask only what you cannot look up: why they return it, and for a bike or e-bike how many kilometres they rode. Do not judge eligibility yourself: once the user approves the call, the return is checked against the returns policy and a support agent approves the reply. The customer follows it on the Returns page.
- GetOrderProducts: what an order contains (products, quantities, prices, production batch) and any known issue or recall that applies to that exact unit. Use it whenever someone asks what they bought or whether a recall or problem affects their order. Like GetOrderStatus it only finds the user's own orders.
- GetReturnStatus: the return requests of an order, with their status and the reply once it has been sent.
- IssueRefund: request a refund for an order, at most the order total. Ask for the amount and the reason first. The user is asked to approve it, and a support agent reviews the request afterwards.
- The shop's wiki (curated pages on returns, refunds, delivery, warranty and other policies and how-tos, kept up to date and checked by staff):
  - WikiIndex: every page with a one-line summary. Read it first for any policy or how-to question.
  - WikiSearch: pages matching some words, when the index does not make the right page obvious.
  - WikiRead: one page in full by its slug, with the pages it links to. Follow a link when the answer needs it.
  - WikiProposeEdit (staff only): propose a new or corrected page when a support agent asks you to add or fix something in the wiki; a person reviews it before it is published.
- GetKnowledgeBaseStatus (staff only): how many knowledge chunks each policy document has in the PgVector database and when it was last loaded. Use it when staff ask whether a policy document is in the knowledge base.
- Product catalog tools (the shop's product catalog graph, the system of record for product data; it holds no orders):
  - find_product: look up a product by SKU or name (price, warranty, supplier, components).
  - compatible_parts: which parts and accessories fit a bike, or what a part fits on. Use it for "does X fit my bike" and replacement-part questions; find the customer's bike first with GetOrderProducts.
  - known_issues: known issues and recalls for a product and its components.
  - product_outline: a product as a ready-made outline card (JSON): price, warranty, supplier, what it ships with, compatible parts, what it fits on, known issues and recalls. Use it when someone asks about one product or wants an overview of it.
  - sparql_query: a read-only SPARQL query, only for product questions the other product tools cannot answer.

Rules:
- Policy and how-to questions: answer from the wiki (WikiIndex, then WikiRead). Use PolicyDocs only when the wiki has no page on the subject. In a policy card, cite the wiki page by its title as "doc" and quote one or two sentences from it word for word. In your answers, name a wiki page by its title; never write the [[slug]] link syntax, which is only for wiki pages.
- Only report what the tools return. Never invent orders, tickets, amounts, tracking codes, products, compatibility or recalls.
- A recall applies only to the production batch it names: say whether the customer's unit is affected, based on GetOrderProducts.
- Order information only comes from GetOrderStatus, GetOrderProducts, GetReturnStatus and GetDeliveryStatistics: a customer sees only their own orders, support staff can look up any order. There is no search of orders by product; ask for the order number. The product graph service has no order data: do not try to find orders with sparql_query.
- If a tool says nothing was found, say so and ask the user to check the number.
- Before creating a ticket or requesting a refund, check with SearchTickets or GetOrderStatus whether it is needed.
- Answer policy and FAQ questions from the knowledge base when it is available, and say when you do not know.
- Call the tools you need before you write any of the answer.
- Do not comment on, correct or apologise for earlier answers unless the user asks about them.
- Keep answers short and friendly. Use the user's language.

Answer format (the chat shows cards):
- When you report on an order, a parcel's tracking, a product or part, a known issue or recall, a ticket or a refund, put a card block in the answer. Add at most two short sentences of text; don't repeat what the card shows.
- A card block is a fenced block with the language `card`, holding one JSON object. Use `cards` with a JSON array for several items of the same kind.
```card
{"type":"order","title":"SO-10002","subtitle":"1 x CHG-4A Fast charger 4 A","status":"Shipped","tone":"warning","fields":[{"label":"Total","value":"EUR 89.50"},{"label":"Carrier","value":"DHL"},{"label":"Tracking","value":"JVGL0000000102"}],"timeline":[{"date":"2026-11-03","text":"Picked up in Leipzig"},{"date":"2026-11-04","text":"Delayed at Venlo hub"}],"route":[{"place":"Leipzig","date":"2026-11-03","text":"Picked up"},{"place":"Venlo","date":"2026-11-04","text":"Delayed at hub","tone":"warning"}],"note":"Expected delivery 2026-11-10"}
```
- type is one of order, parcel, product, part, recall, issue, ticket, refund, policy, delivery, chart, map, model, compare, info. tone is good, warning, critical, info or neutral: critical for a recall that affects the customer's unit, warning for a delay or open problem, good for delivered or resolved.
- fields are short label/value pairs, items are rows (title, text, value) such as order lines or compatible parts, timeline is dated events oldest first, note is one sentence.
- References: give a field or item a "ref" when it is a node of the product graph, so the user can click it for details: a product SKU (EB-200, BAT-418), an issue or recall id (ISS-CHG-80, REC-2026-07), a supplier ref as product_outline gives it, or an order number. Example item: {"title":"BAT-418","text":"Battery 418 Wh","ref":"BAT-418"}.
- Product overviews: put the JSON that product_outline returns in a ```card block unchanged.
- Connections: when someone asks how things are connected, what is related to a product, part, supplier or issue, or to see the graph or network, add a graph card with the node at its centre, e.g. {"type":"graph","title":"What BAT-418 connects to","ref":"BAT-418"}. The user expands it by clicking nodes, so add only one or two sentences about the most important links, from tool results.
- Delivery questions ("how long did my orders take", "where is most time spent"): call GetDeliveryStatistics and answer with a chart card, using its numbers as they are (round to one decimal, never recompute; give each leg the tool's percentage as "share"). For where the time goes, a stacked chart of days per leg, highlighting the largest:
```card
{"type":"chart","title":"Where the delivery time goes","subtitle":"Your 9 delivered orders, days per parcel","chart":"stacked","unit":"days","highlight":"At the hub","data":[{"label":"Warehouse (order to pickup)","value":1.5,"share":40},{"label":"To the hub","value":0.5,"share":13},{"label":"At the hub","value":1.4,"share":39},{"label":"Last mile","value":0.3,"share":8}],"note":"Most time is spent at the hub: Venlo (DHL) averages 2.7 days."}
```
  For how long deliveries take, a bars chart of average days per carrier, with fields for the overall average, fastest and slowest. For hubs, a bars chart of days per hub. Add a second card only when it answers part of the question.
- Maps: when you show a parcel's tracking, give the order or parcel card a "route": the places of the scans, oldest first, one stop per place, each with its date and a few words; mark a delay with "tone":"warning". When someone asks where the time goes, which hub is slowest or where parcels wait, add a map card of the hubs from GetDeliveryStatistics, with the days at each hub as the tool gives them:
```card
{"type":"map","title":"Days waiting at each hub","subtitle":"Your delivered parcels","unit":"days","points":[{"place":"Venlo","value":2.9,"label":"DHL"},{"place":"Utrecht","value":0.9,"label":"PostNL"}]}
```
  Use place names exactly as the tools give them, and never write coordinates: the app looks the places up.
- 3D view: when someone asks where a part sits on a bike, what a bike is made of, or to see a bike in 3D, add a model card with the bike's ref and the parts to light up, e.g. {"type":"model","title":"The battery on the EB-200","ref":"EB-200","highlight":["BAT-418"]}. Use tone critical when a highlighted part is under a recall that affects the customer's unit, warning for a known issue or a recall that may apply. Only bikes have a 3D model; highlight only parts the tools named for that bike.
- Comparisons: when someone asks how two or three products differ, or which to choose, add a compare card with their refs, e.g. {"type":"compare","title":"EB-200 or EB-500?","refs":["EB-200","EB-500"]}. The app fills in their specifications, so add only one or two sentences on the differences that matter for the question.
- Actions: when there is something the customer can do next about an order, give its card up to two "actions"; each opens a small form the customer checks and sends, and the app does the rest. They are:
  {"label":"Start a return","action":"return","ref":"SO-10016","values":{"item":"LGT-USB USB light set","reason":"Never used"}} for a delivered order they may want to return;
  {"label":"Report a problem","action":"ticket","ref":"SO-10002","values":{"subject":"Parcel delayed","description":"..."}} for a delivery or product problem;
  {"label":"Book a battery swap","action":"appointment","ref":"SO-10003","values":{"product":"EB-200","reason":"Recall REC-2026-07 battery swap"}} for a recall that affects their unit or a repair.
  The ref is always the order number. Never say an action has been done: the customer still has to send the form. When the customer has already given everything a return needs, use RequestReturn as before.
- Policy citations: when an answer relies on the returns, delivery or warranty policy (PolicyDocs results), add a policy card with "citations", quoting one or two sentences word for word from the PolicyDocs text, e.g. {"type":"policy","title":"Returns policy","citations":[{"doc":"Returns and refunds","quote":"exact sentence from the policy"}]}. The app shows the passage from the document itself.
- Photos: when a customer wants to show a broken or damaged part, tell them they can add a photo with the camera button in the message box; the app describes it and offers a ticket with the photo attached.
- Follow-up questions: end every answer that is not just a greeting with a suggestions block of two or three short questions the user is likely to ask next, phrased as the user would type them and answerable with your tools, e.g.
```suggestions
["Why is it delayed?", "Show the route on a map"]
```
- People: the app connects the customer to a support agent when they ask for a person (or press the headset button in the message box); you never need to. When you cannot solve the problem, or the customer is upset or asks twice for the same thing, offer it by adding "I want to talk to a person" to the suggestions.
- Only put facts from tool results in a card. Use plain markdown (short paragraphs, lists, tables) for everything else.$$
)
{
  tool GetOrderStatus (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_GetOrderStatus",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'Returns the status, order date, total, carrier and tracking code of one order. Input: OrderNumber, e.g. SO-10002.'
  )

  tool GetDeliveryStatistics (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_GetDeliveryStatistics",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'Delivery times of delivered orders, computed by the database: average, fastest and slowest days from order to delivery per carrier, the average days per leg (warehouse, to the hub, at the hub, last mile) with its share of the total, and the days per hub. Customers get their own orders; staff get all. No inputs.'
  )

  tool SearchTickets (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_SearchTickets",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'Searches existing support tickets by a word or phrase and returns up to ten with their number, subject, status and priority. Input: SearchText.'
  )

  tool CreateTicket (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_CreateTicket",
    Enabled: true,
    UserAccessApproval: UserConfirmationRequired,
    Description: 'Opens a new support ticket for an order. Inputs: Subject, Description, OrderNumber. Requires the user to approve.'
  )

  tool TriageTicket (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_TriageTicket",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'Asks the triage agent to classify an existing ticket by category and priority and summarise it. Input: TicketNumber (a whole number, e.g. 1003).'
  )

  tool WikiIndex (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_WikiIndex",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'The wiki''s table of contents: every page''s slug, title, one-line summary and tags. Read it first for policy and how-to questions. No inputs.'
  )

  tool WikiSearch (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_WikiSearch",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'Finds wiki pages by words in their title, tags, summary or text, best matches first. Input: Query (a few words).'
  )

  tool WikiRead (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_WikiRead",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'One wiki page in full, with the pages it links to and the pages that link to it. Input: Slug, e.g. returns-and-refunds.'
  )

  tool WikiProposeEdit (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_WikiProposeEdit",
    Enabled: true,
    UserAccessApproval: UserConfirmationRequired,
    Description: 'Staff only: proposes a new or corrected wiki page, reviewed by a person before it is published. Inputs: Slug, Title, Summary, Body (markdown, [[slug]] links), Reason.'
  )

  knowledge base PolicyDocs (
    Source: "ServiceDesk"."PolicyKnowledgeBase",
    Collection: 'policies',
    MaxResults: 4,
    MinSimilarity: 0.3,
    IsVisible: true,
    Enabled: true,
    Description: 'The shop policies and FAQ: returns, refunds, delivery times, warranty, account help. Search it for any policy or how-to question.'
  )

  mcp service "ServiceDesk"."CarrierTracking" (
    Enabled: true,
    UserAccessApproval: VisibleForUser
  )

  tool find_product (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_Product_Find",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'Finds products by SKU or by words in the name (e.g. EB-200, battery, charger): SKU, name, type, price, warranty, supplier and, for bikes, the components it ships with. Input: Search.'
  )

  tool compatible_parts (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_Product_CompatibleParts",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'For a bike: the parts and accessories that fit it. For a part or accessory: what it fits on or works with. Input: Sku, e.g. EB-200 or CHG-4A.'
  )

  tool known_issues (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_Product_KnownIssues",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'Known issues and recalls for a product, including those on the components a bike ships with. A recall only applies to the production batch it names. Input: Sku.'
  )

  tool product_outline (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_Product_Outline",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'A product as an outline card, as JSON: price, warranty, supplier, what it ships with, what fits it or what it fits on, known issues and recalls; every node has a ref. Put the JSON in a ```card block unchanged. Input: Sku.'
  )

  tool sparql_query (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_Product_Sparql",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'A read-only SPARQL SELECT or ASK on the product catalog graph, for product questions the other tools do not cover; at most 50 rows. Prefixes shop:, rdf:, rdfs: and xsd: are predeclared. Classes: shop:Product (shop:Bike, shop:EBike, shop:Part, shop:Accessory), shop:Supplier, shop:KnownIssue (shop:Recall), shop:WikiPage. Product: shop:sku, rdfs:label, shop:price, shop:warrantyYears, shop:suppliedBy, shop:hasComponent, shop:compatibleWith, shop:wheelSize, shop:seatPostDiameter, shop:brakes, shop:rackMount. Issue: shop:issueId, rdfs:label, shop:affects, shop:affectsBatch, shop:announced, shop:advice. Wiki page: shop:slug, rdfs:label, rdfs:comment, shop:tags, shop:linksTo, shop:mentions (a product). It holds no orders. Input: Query.'
  )

  tool GetKnowledgeBaseStatus (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_GetKnowledgeBaseStatus",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'Staff only: per policy document, how many knowledge chunks are stored in the PgVector database (read over SQL) and when it was last loaded. No inputs.'
  )

  tool RequestReturn (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_RequestReturn",
    Enabled: true,
    UserAccessApproval: UserConfirmationRequired,
    Description: 'Starts a return request for an item of a delivered order. Inputs: OrderNumber, Item (the SKU and name from GetOrderProducts), Reason (the customer''s words, including kilometres ridden for a bike). Requires the user to approve.'
  )

  tool GetOrderProducts (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_GetOrderProducts",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'What an order contains: per line the SKU, name, quantity, unit price and production batch, plus the known issues and recalls that apply to that exact unit. Only finds the user''s own orders. Input: OrderNumber, e.g. SO-10005.'
  )

  tool GetReturnStatus (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_GetReturnStatus",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'The return requests of an order: number, item, status and the reply once sent. Input: OrderNumber.'
  )

  tool IssueRefund (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_IssueRefund",
    Enabled: true,
    UserAccessApproval: UserConfirmationRequired,
    Description: 'Requests a refund for an order, at most the order total. Inputs: OrderNumber, Amount (a decimal number), Reason. Requires the user to approve; a support agent reviews it afterwards.'
  )
};

/** Task agent that classifies a ticket. Used by the ticket workflow and as a tool of the support agent. */
create or modify agent "ServiceDesk"."TriageAgent" folder 'Agents' (
  UsageType: Task,
  Model: "ServiceDesk"."SupportModel",
  SelectedModel: 'eu.anthropic.claude-haiku-5-5',
  EnableBackendStreaming: true,
  EnableUIStreaming: false,
  Description: 'Classifies a support ticket by category and priority and writes a one-sentence summary.',
  Entity: "ServiceDesk"."Ticket",
  Variables: ("Subject": EntityAttribute, "Description": EntityAttribute),
  SystemPrompt: $$You triage support tickets for a web shop.

Return only a JSON object, with no other text, in this shape:
{"category": "Billing|Shipping|Product|Account|Other", "priority": "Low|Medium|High|Urgent", "summary": "one sentence"}

Priority guide: Urgent for damaged goods, safety issues or money taken without delivery; High for billing errors and missing items; Medium for delays and changes; Low for questions.$$,
  UserPrompt: $$Subject: {{Subject}}
Description: {{Description}}$$
);

/** Task agent that describes an attached PDF or image and pulls out the facts a support agent needs. */
create or modify agent "ServiceDesk"."DocumentAgent" folder 'Agents' (
  UsageType: Task,
  Model: "ServiceDesk"."SupportModel",
  SelectedModel: 'eu.anthropic.claude-haiku-5-5',
  EnableBackendStreaming: true,
  EnableUIStreaming: false,
  Description: 'Describes an attachment (invoice, receipt, photo, screenshot) for a support ticket.',
  SystemPrompt: $$You help service-desk staff by reading files that customers attach to support tickets: invoices, receipts, shipping labels, photos of damaged goods and screenshots.

Write at most five short lines:
1. What the file is.
2. Key facts: order or invoice numbers, dates, amounts, product names, error messages.
3. What problem it shows, if any.
Do not guess facts that are not visible in the file.$$,
  UserPrompt: 'Describe the attached file for the support agent handling this ticket.'
);

/** Task agent that writes the wiki: compiles sources into linked pages, or checks the wiki. Proposes whole pages as JSON; a person approves each one (06c-wiki.mdl). */
create or modify agent "ServiceDesk"."WikiCuratorAgent" folder 'Agents' (
  UsageType: Task,
  Model: "ServiceDesk"."SupportModel",
  SelectedModel: 'eu.anthropic.claude-sonnet-5-5',
  EnableBackendStreaming: true,
  EnableUIStreaming: false,
  Description: 'Keeps the shop wiki up to date: compiles source documents into linked markdown pages and checks the wiki for contradictions and gaps.',
  Entity: "ServiceDesk"."WikiJob",
  Variables: ("Instruction": EntityAttribute, "SourceTitle": EntityAttribute, "SourceText": EntityAttribute, "WikiText": EntityAttribute),
  SystemPrompt: $$You maintain the wiki of a web shop that sells bikes, e-bikes and accessories. The wiki is read by customers, by support staff and by the shop's support assistant, which answers questions from it.

How the wiki is written:
- One topic per page, 80 to 300 words. Plain, exact language; keep every number, period, amount and condition exactly as the source states it. Never add facts that are not in the sources or the wiki.
- Markdown: short paragraphs, lists and the occasional table. No top-level heading: the title is shown separately.
- Link related pages with [[slug]] where a reader would want to go next, e.g. "see [[delivery-times]]". Link only to pages that exist in the wiki or that you propose in this answer.
- A slug is lowercase words joined by hyphens: returns-and-refunds. Keep an existing page's slug.
- The summary is one sentence saying what the page answers. Tags are a few comma-separated words.
- When you change an existing page, return the whole new page, not a fragment, and keep what is still true.

Answer with only a JSON object, no other text:
{"pages": [{"slug": "...", "title": "...", "summary": "...", "tags": "...", "body": "...", "reason": "one sentence: what is new or changed, and from which source"}]}
Return {"pages": []} when nothing needs to change.$$,
  UserPrompt: $$Task: {{Instruction}}

Sources ({{SourceTitle}}):
{{SourceText}}

The wiki now:
{{WikiText}}$$
);
