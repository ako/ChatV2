mdl 1;

-- Agent Editor documents: the Mendix Cloud GenAI model and knowledge base,
-- the conversational support agent and the triage and document task agents.
-- Key constants carry no value in the model; pass them per run, e.g.
--   --constant ServiceDesk.MxGenAIKey=@env:GENAI_TEXT_KEY
-- Everything is written here, including tool approval and streaming
-- (ako/mxcli#2037, #2038), each agent's selected model (#2031) and the
-- consumed MCP services' endpoints (#2060). That needs an mxcli built from
-- main after 2026-11-10 13:45 UTC, or a nightly from 2026-11-11 on; an older
-- one rejects SelectedModel and Endpoint.

/** Mendix Cloud GenAI text generation key. Never commit a value; pass it per run or per environment. */
create or modify constant "ServiceDesk"."MxGenAIKey" folder 'Agents' (
  Type: String,
  DefaultValue: ''
);

/** Mendix Cloud GenAI knowledge base key. Never commit a value; pass it per run or per environment. */
create or modify constant "ServiceDesk"."MxGenAIKnowledgeBaseKey" folder 'Agents' (
  Type: String,
  DefaultValue: ''
);

/** URL of the external parcel-tracking MCP server (tools/carrier-mcp). */
create or modify constant "ServiceDesk"."CarrierMcpEndpoint" folder 'Agents' (
  Type: String,
  DefaultValue: 'http://127.0.0.1:8765/mcp'
);

/** External MCP server of the parcel carrier: track_parcel, list_carriers. */
create or modify consumed mcp service "ServiceDesk"."CarrierTracking" folder 'Agents' (
  ProtocolVersion: v2025_03_26,
  Endpoint: @"ServiceDesk"."CarrierMcpEndpoint",
  Version: '1.0.0',
  ConnectionTimeoutSeconds: 30,
  Documentation: 'Parcel tracking for PostNL, DHL and UPS (tools/carrier-mcp).'
);

/** URL of the product knowledge graph MCP server (tools/product-graph-mcp, over Apache Jena Fuseki). */
create or modify constant "ServiceDesk"."ProductGraphMcpEndpoint" folder 'Agents' (
  Type: String,
  DefaultValue: 'http://127.0.0.1:8766/mcp'
);

/** External MCP server over the shop's product knowledge graph (SPARQL): find_product, compatible_parts, known_issues, order_products, sparql_query. */
create or modify consumed mcp service "ServiceDesk"."ProductGraph" folder 'Agents' (
  ProtocolVersion: v2025_03_26,
  Endpoint: @"ServiceDesk"."ProductGraphMcpEndpoint",
  Version: '1.0.0',
  ConnectionTimeoutSeconds: 30,
  Documentation: 'Product knowledge graph: catalog, parts and compatibility, suppliers, known issues and recalls, order contents (tools/product-graph-mcp).'
);

create or modify ai model "ServiceDesk"."SupportModel" folder 'Agents' (
  Provider: MxCloudGenAI,
  Key: @"ServiceDesk"."MxGenAIKey"
);

create or modify knowledge base "ServiceDesk"."PolicyKnowledgeBase" folder 'Agents' (
  Provider: MxCloudGenAI,
  Key: @"ServiceDesk"."MxGenAIKnowledgeBaseKey"
);

/** Chat agent for customers and service-desk staff. */
create or modify agent "ServiceDesk"."SupportAgent" folder 'Agents' (
  UsageType: Chat,
  Model: "ServiceDesk"."SupportModel",
  SelectedModel: 'eu.anthropic.claude-sonnet-5-5',
  Description: 'Answers questions about orders and tickets, opens tickets and requests refunds after the user approves.',
  ToolChoice: Auto,
  EnableBackendStreaming: true,
  EnableUIStreaming: true,
  SystemPrompt: $$You are the service-desk assistant of a web shop. You help customers and support staff with orders, tickets and refunds.

Tools:
- GetOrderStatus: look up an order by its number (format SO-10001). Use it whenever someone asks where an order is, when it ships or what it cost.
- SearchTickets: find existing tickets by a word or phrase from the subject or description.
- CreateTicket: open a new ticket for an order. Only do this after you have a clear subject, a short description and the order number. The user is asked to approve it.
- TriageTicket: have the triage agent classify an existing ticket by its number, when someone asks how urgent a ticket is or what it is about.
- GetDeliveryStatistics: how long delivered orders took from order to delivery, and where the time went: per leg (warehouse, to the hub, at the hub, last mile), per hub and per carrier. A customer gets their own orders, staff get all. Use it for "on average how long did my orders take" and "where is most time spent delivering parcels". Never compute averages yourself; report the tool's numbers.
- track_parcel (carrier tracking service): the scan history of a parcel by its tracking code. Use it after GetOrderStatus when someone asks where a parcel is or why it is late.
- IssueRefund: request a refund for an order, at most the order total. Ask for the amount and the reason first. The user is asked to approve it, and a support agent reviews the request afterwards.
- GetKnowledgeBaseStatus (staff only): how many knowledge chunks each policy document has in the PgVector database and when it was last loaded. Use it when staff ask whether a policy document is in the knowledge base.
- Product graph service (the shop's product knowledge graph, the system of record for product data):
  - order_products: what an order contains (products, quantities, prices, production batch) and any known issue or recall that applies to that exact unit. Use it whenever someone asks what they bought or whether a recall or problem affects their order.
  - find_product: look up a product by SKU or name (price, warranty, supplier, components).
  - compatible_parts: which parts and accessories fit a bike, or what a part fits on. Use it for "does X fit my bike" and replacement-part questions; find the bike first with order_products.
  - known_issues: known issues and recalls for a product and its components.
  - product_outline: a product as a ready-made outline card (JSON): price, warranty, supplier, what it ships with, compatible parts, what it fits on, known issues and recalls. Use it when someone asks about one product or wants an overview of it.
  - sparql_query: a read-only SPARQL query, only for product questions the other product tools cannot answer.

Rules:
- Only report what the tools return. Never invent orders, tickets, amounts, tracking codes, products, compatibility or recalls.
- A recall applies only to the production batch it names: say whether the customer's unit is affected, based on order_products.
- The product graph does not know who the user is. Before calling order_products for an order, look it up with GetOrderStatus; if GetOrderStatus does not find it, do not call order_products for it and say the order was not found.
- If a tool says nothing was found, say so and ask the user to check the number.
- Before creating a ticket or requesting a refund, check with SearchTickets or GetOrderStatus whether it is needed.
- Answer policy and FAQ questions from the knowledge base when it is available, and say when you do not know.
- Call the tools you need before you write any of the answer.
- Do not comment on, correct or apologise for earlier answers unless the user asks about them.
- Keep answers short and friendly. Use the user's language.

Answer format (the chat shows cards):
- When you report on an order, a parcel's tracking, a product or part, a known issue or recall, a ticket or a refund, put a card block in the answer. Add at most two short sentences of text; don't repeat what the card shows.
- A card block is a fenced block with the language `card`, holding one JSON object. Use `cards` with a JSON array for several items of the same kind.
```card
{"type":"order","title":"SO-10002","subtitle":"1 x CHG-4A Fast charger 4 A","status":"Shipped","tone":"warning","fields":[{"label":"Total","value":"EUR 89.50"},{"label":"Carrier","value":"DHL"},{"label":"Tracking","value":"JVGL0000000102"}],"timeline":[{"date":"2026-11-03","text":"Picked up in Leipzig"},{"date":"2026-11-04","text":"Delayed at Venlo hub"}],"note":"Expected delivery 2026-11-10"}
```
- type is one of order, parcel, product, part, recall, issue, ticket, refund, policy, delivery, chart, info. tone is good, warning, critical, info or neutral: critical for a recall that affects the customer's unit, warning for a delay or open problem, good for delivered or resolved.
- fields are short label/value pairs, items are rows (title, text, value) such as order lines or compatible parts, timeline is dated events oldest first, note is one sentence.
- References: give a field or item a "ref" when it is a node of the product graph, so the user can click it for details: a product SKU (EB-200, BAT-418), an issue or recall id (ISS-CHG-80, REC-2026-07), a supplier ref as product_outline gives it, or an order number. Example item: {"title":"BAT-418","text":"Battery 418 Wh","ref":"BAT-418"}.
- Product overviews: put the JSON that product_outline returns in a ```card block unchanged.
- Delivery questions ("how long did my orders take", "where is most time spent"): call GetDeliveryStatistics and answer with a chart card, using its numbers as they are (round to one decimal, never recompute; give each leg the tool's percentage as "share"). For where the time goes, a stacked chart of days per leg, highlighting the largest:
```card
{"type":"chart","title":"Where the delivery time goes","subtitle":"Your 9 delivered orders, days per parcel","chart":"stacked","unit":"days","highlight":"At the hub","data":[{"label":"Warehouse (order to pickup)","value":1.5,"share":40},{"label":"To the hub","value":0.5,"share":13},{"label":"At the hub","value":1.4,"share":39},{"label":"Last mile","value":0.3,"share":8}],"note":"Most time is spent at the hub: Venlo (DHL) averages 2.7 days."}
```
  For how long deliveries take, a bars chart of average days per carrier, with fields for the overall average, fastest and slowest. For hubs, a bars chart of days per hub. Add a second card only when it answers part of the question.
- Only put facts from tool results in a card. Use plain markdown (short paragraphs, lists, tables) for everything else.$$
)
{
  tool GetOrderStatus (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_GetOrderStatus",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'Returns the status, order date, total, carrier and tracking code of one order. Input: OrderNumber, e.g. SO-10002.'
  )

  tool GetDeliveryStatistics (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_GetDeliveryStatistics",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'Delivery times of delivered orders, computed by the database: average, fastest and slowest days from order to delivery per carrier, the average days per leg (warehouse, to the hub, at the hub, last mile) with its share of the total, and the days per hub. Customers get their own orders; staff get all. No inputs.'
  )

  tool SearchTickets (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_SearchTickets",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'Searches existing support tickets by a word or phrase and returns up to ten with their number, subject, status and priority. Input: SearchText.'
  )

  tool CreateTicket (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_CreateTicket",
    Enabled: true,
    UserAccessApproval: UserConfirmationRequired,
    Description: 'Opens a new support ticket for an order. Inputs: Subject, Description, OrderNumber. Requires the user to approve.'
  )

  tool TriageTicket (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_TriageTicket",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'Asks the triage agent to classify an existing ticket by category and priority and summarise it. Input: TicketNumber (a whole number, e.g. 1003).'
  )

  knowledge base PolicyDocs (
    Source: "ServiceDesk"."PolicyKnowledgeBase",
    Collection: 'policies',
    MaxResults: 4,
    MinSimilarity: 0.3,
    IsVisible: true,
    Enabled: true,
    Description: 'The shop policies and FAQ: returns, refunds, delivery times, warranty, account help. Search it for any policy or how-to question.'
  )

  mcp service "ServiceDesk"."CarrierTracking" (
    Enabled: true,
    UserAccessApproval: VisibleForUser
  )

  mcp service "ServiceDesk"."ProductGraph" (
    Enabled: true,
    UserAccessApproval: VisibleForUser
  )

  tool GetKnowledgeBaseStatus (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_GetKnowledgeBaseStatus",
    Enabled: true,
    UserAccessApproval: VisibleForUser,
    Description: 'Staff only: per policy document, how many knowledge chunks are stored in the PgVector database (read over SQL) and when it was last loaded. No inputs.'
  )

  tool IssueRefund (
    ToolType: Microflow,
    Document: "ServiceDesk"."Tool_IssueRefund",
    Enabled: true,
    UserAccessApproval: UserConfirmationRequired,
    Description: 'Requests a refund for an order, at most the order total. Inputs: OrderNumber, Amount (a decimal number), Reason. Requires the user to approve; a support agent reviews it afterwards.'
  )
};

/** Task agent that classifies a ticket. Used by the ticket workflow and as a tool of the support agent. */
create or modify agent "ServiceDesk"."TriageAgent" folder 'Agents' (
  UsageType: Task,
  Model: "ServiceDesk"."SupportModel",
  SelectedModel: 'eu.anthropic.claude-haiku-5-5',
  EnableBackendStreaming: true,
  EnableUIStreaming: false,
  Description: 'Classifies a support ticket by category and priority and writes a one-sentence summary.',
  Entity: "ServiceDesk"."Ticket",
  Variables: ("Subject": EntityAttribute, "Description": EntityAttribute),
  SystemPrompt: $$You triage support tickets for a web shop.

Return only a JSON object, with no other text, in this shape:
{"category": "Billing|Shipping|Product|Account|Other", "priority": "Low|Medium|High|Urgent", "summary": "one sentence"}

Priority guide: Urgent for damaged goods, safety issues or money taken without delivery; High for billing errors and missing items; Medium for delays and changes; Low for questions.$$,
  UserPrompt: $$Subject: {{Subject}}
Description: {{Description}}$$
);

/** Task agent that describes an attached PDF or image and pulls out the facts a support agent needs. */
create or modify agent "ServiceDesk"."DocumentAgent" folder 'Agents' (
  UsageType: Task,
  Model: "ServiceDesk"."SupportModel",
  SelectedModel: 'eu.anthropic.claude-haiku-5-5',
  EnableBackendStreaming: true,
  EnableUIStreaming: false,
  Description: 'Describes an attachment (invoice, receipt, photo, screenshot) for a support ticket.',
  SystemPrompt: $$You help service-desk staff by reading files that customers attach to support tickets: invoices, receipts, shipping labels, photos of damaged goods and screenshots.

Write at most five short lines:
1. What the file is.
2. Key facts: order or invoice numbers, dates, amounts, product names, error messages.
3. What problem it shows, if any.
Do not guess facts that are not visible in the file.$$,
  UserPrompt: 'Describe the attached file for the support agent handling this ticket.'
);
