mdl 1;

-- Slice 03: publish the service desk as an MCP server (runtime configuration,
-- MCP Server module 5.4). External agents such as Claude Code can then look up
-- orders and tickets, as the signed-in user, and use a reply-drafting prompt.
-- Pattern from the mcp-server skill (ako/mxcli#2041). Two servers: /servicedesk/mcp
-- (app-account headers) and /servicedesk-oauth/mcp (OAuth 2.0 bearer tokens from a
-- local Keycloak, tools/keycloak). The Published MCP Service document (model
-- configuration) is not writable from MDL yet (ako/mxcli#2020).

/** Authenticates an MCP request with the app's own accounts: headers Username and Password. Returns empty to refuse the request. */
create or modify microflow "ServiceDesk"."MCP_Authenticate" (
  $HttpRequest: System.HttpRequest,
  $McpServer: MCPServer.McpServer
)
returns System.User as $User
folder 'MCP'
begin
  retrieve $Headers from $HttpRequest/System.HttpHeaders;
  $UserName = find $Headers by Key = 'Username';
  $Password = find $Headers by Key = 'Password';
  if $UserName = empty or $Password = empty then
    return empty;
  end if;
  retrieve $Account from System.User where [Name = $UserName/Value] first;
  if $Account = empty then
    return empty;
  end if;
  $Valid = call java action System.VerifyPassword(userName = $UserName/Value, password = $Password/Value);
  if $Valid then
    return $Account;
  end if;
  return empty;
end;

/** MCP prompt: drafts a reply to a ticket, with the ticket's details filled in. */
create or modify microflow "ServiceDesk"."MCPPrompt_TicketReply" (
  $Prompt: MCPServer.Prompt,
  $TicketNumber: String
)
returns MCPServer.PromptMessage as $Message
folder 'MCP'
begin
  $Customer = call microflow "ServiceDesk"."SUB_GetCurrentCustomer" ();
  $Ticket = call microflow "ServiceDesk"."SUB_FindTicketForCustomer" (TicketNumber = parseInteger($TicketNumber), Customer = $Customer);
  if $Ticket = empty then
    $NotFound = create MCPServer.PromptMessage (Role = 'USER', Content = 'Ticket ' + $TicketNumber + ' was not found for this user. Ask for the correct ticket number.');
    return $NotFound;
  end if;
  $Message = create MCPServer.PromptMessage (
    Role = 'USER',
    Content = 'Draft a short, friendly reply to the customer for support ticket #' + toString($Ticket/TicketNumber)
      + '. Subject: ' + $Ticket/Subject
      + '. Description: ' + (if $Ticket/Description = empty then '(none)' else $Ticket/Description)
      + '. Current status: ' + getCaption($Ticket/Status)
      + '. Explain the next step and do not promise a refund that has not been approved.'
  );
  return $Message;
end;

/** OAuth issuer the OAuth-protected MCP server sends clients to (local Keycloak, tools/keycloak). */
create or modify constant "ServiceDesk"."OAuthIssuerUrl" folder 'MCP' ( Type: String, DefaultValue: 'http://localhost:8280/realms/servicedesk' );
/** Token introspection endpoint of the OAuth issuer (RFC 7662). */
create or modify constant "ServiceDesk"."OAuthIntrospectionUrl" folder 'MCP' ( Type: String, DefaultValue: 'http://localhost:8280/realms/servicedesk/protocol/openid-connect/token/introspect' );
/** Client the app uses to introspect tokens; also the audience a token must carry. */
create or modify constant "ServiceDesk"."OAuthClientId" folder 'MCP' ( Type: String, DefaultValue: 'servicedesk-mcp' );
/** Secret of the introspection client. No value in the model; pass it per run or per environment. */
create or modify constant "ServiceDesk"."OAuthClientSecret" folder 'MCP' ( Type: String, DefaultValue: '' );
/** Scope a token must hold to call the MCP server. */
create or modify constant "ServiceDesk"."OAuthRequiredScope" folder 'MCP' ( Type: String, DefaultValue: 'mcp:tools' );

/** The issuer's answer about a bearer token (RFC 7662 introspection). */
create or modify non-persistent entity "ServiceDesk"."TokenIntrospection" (
  "Active": Boolean,
  "Audience": String(500),
  "UserName": String(200),
  "Scope": String(2000)
);

create or modify json structure "ServiceDesk"."JSON_TokenIntrospection" folder 'MCP'
  sample '{"active": true, "aud": "servicedesk-mcp", "preferred_username": "demo_customer", "scope": "openid mcp:tools"}';

create or modify import mapping "ServiceDesk"."IMM_TokenIntrospection"
  with json structure "ServiceDesk"."JSON_TokenIntrospection"
{
  create "ServiceDesk"."TokenIntrospection" {
    Active = active,
    Audience = aud,
    UserName = preferred_username,
    Scope = scope
  }
};

/** MCP prompt: answer a question from the shop's wiki (06c-wiki.mdl). Hands the client the wiki's index and how to use the wiki tools. */
create or modify microflow "ServiceDesk"."MCPPrompt_WikiAnswer" (
  $Prompt: MCPServer.Prompt,
  $Question: String
)
returns MCPServer.PromptMessage as $Message
folder 'MCP'
begin
  declare $NL String = urlDecode('%0A');
  $Index = call microflow "ServiceDesk"."Tool_WikiIndex" ();
  $Message = create MCPServer.PromptMessage (
    Role = 'USER',
    Content = 'Answer this question from the service desk wiki: ' + (if $Question = empty then '' else $Question) + $NL + $NL
      + 'Use wiki_read with a slug from the index below to open the pages you need, and follow their links when the answer depends on them. Use wiki_search when the index does not make the page obvious. Answer only from what the pages say, and name the pages you used.' + $NL + $NL
      + $Index
  );
  return $Message;
end;

/** Authenticates an MCP request with an OAuth bearer token: introspects it at the issuer, requires it to be active, issued for this server (audience) and to hold the required scope, then maps preferred_username to the app user. Never throws: any failure returns empty, which the MCP module answers with 401. */
create or modify microflow "ServiceDesk"."MCP_Authenticate_OAuth" (
  $HttpRequest: System.HttpRequest,
  $McpServer: MCPServer.McpServer
)
returns System.User as $User
folder 'MCP'
begin
  retrieve $Headers from $HttpRequest/System.HttpHeaders;
  $AuthHeader = find $Headers where toLowerCase($currentObject/Key) = 'authorization';
  if $AuthHeader = empty or not(startsWith($AuthHeader/Value, 'Bearer ')) then
    return empty;
  end if;
  declare $Token String = trim(substring($AuthHeader/Value, 7));
  $Answer = call rest service post '{1}' with ({1} = @ServiceDesk.OAuthIntrospectionUrl) (
    Headers: ('Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json'),
    Authentication: basic (Username: @ServiceDesk.OAuthClientId, Password: @ServiceDesk.OAuthClientSecret),
    Body: template 'token={1}' with ({1} = urlEncode($Token)),
    Timeout: 10,
  ) returns string on error without rollback begin
    log warning node 'ServiceDesk' 'Token introspection failed: {1}' with ({1} = $latestError/Message);
    return empty;
  end error;
  $Info = import from mapping "ServiceDesk"."IMM_TokenIntrospection"($Answer) on error without rollback begin
    log warning node 'ServiceDesk' 'Token introspection answer not understood: {1}' with ({1} = $Answer);
    return empty;
  end error;
  if not($Info/Active)
    or $Info/Audience != @ServiceDesk.OAuthClientId
    or not(contains(' ' + $Info/Scope + ' ', ' ' + @ServiceDesk.OAuthRequiredScope + ' ')) then
    log info node 'ServiceDesk' 'MCP request refused: token inactive, for another audience or without scope {1}.' with ({1} = @ServiceDesk.OAuthRequiredScope);
    return empty;
  end if;
  retrieve $Account from System.User where [Name = $Info/UserName] first;
  return $Account;
end;

/** Registers the service-desk tools, the wiki tools and the ticket-reply and wiki-answer prompts on an MCP server. */
create or modify microflow "ServiceDesk"."SUB_MCP_RegisterTools" ($McpServer: MCPServer.McpServer)
folder 'MCP'
begin
  $OrderTool = call java action MCPServer.AddTool(
    McpServer = $McpServer,
    Name = 'get_order_status',
    Description = 'Status, order date, total, carrier and tracking code of one order, e.g. SO-10002. Customers only see their own orders.',
    ExecutingMicroflow = 'ServiceDesk.Tool_GetOrderStatus',
    Schema = '{"type": "object", "properties": {"OrderNumber": {"type": "string", "description": "Order number, e.g. SO-10002"}}, "required": ["OrderNumber"]}',
    Title = 'Order status'
  );
  $TicketTool = call java action MCPServer.AddTool(
    McpServer = $McpServer,
    Name = 'search_tickets',
    Description = 'Up to ten support tickets whose subject or description contains the search text, with status and priority. Customers only see their own tickets.',
    ExecutingMicroflow = 'ServiceDesk.Tool_SearchTickets',
    Schema = '{"type": "object", "properties": {"SearchText": {"type": "string", "description": "A word or phrase"}}, "required": ["SearchText"]}',
    Title = 'Search tickets'
  );
  -- the wiki (06c-wiki.mdl): read by anyone signed in; proposing an edit is for staff and goes through review
  $WikiIndexTool = call java action MCPServer.AddTool(
    McpServer = $McpServer,
    Name = 'wiki_index',
    Description = 'The service desk wiki''s table of contents: every page''s slug, title, one-line summary and tags. Read it first for questions about returns, refunds, delivery, warranty and other policies.',
    ExecutingMicroflow = 'ServiceDesk.Tool_WikiIndex',
    Schema = '{"type": "object", "properties": {}}',
    Title = 'Wiki index'
  );
  $WikiSearchTool = call java action MCPServer.AddTool(
    McpServer = $McpServer,
    Name = 'wiki_search',
    Description = 'Finds wiki pages by words in their title, tags, summary or text, best matches first.',
    ExecutingMicroflow = 'ServiceDesk.Tool_WikiSearch',
    Schema = '{"type": "object", "properties": {"Query": {"type": "string", "description": "A few words, e.g. return e-bike"}}, "required": ["Query"]}',
    Title = 'Search the wiki'
  );
  $WikiReadTool = call java action MCPServer.AddTool(
    McpServer = $McpServer,
    Name = 'wiki_read',
    Description = 'One wiki page in full (markdown, [[slug]] links), with the pages it links to and the pages that link to it.',
    ExecutingMicroflow = 'ServiceDesk.Tool_WikiRead',
    Schema = '{"type": "object", "properties": {"Slug": {"type": "string", "description": "The page slug from wiki_index, e.g. returns"}}, "required": ["Slug"]}',
    Title = 'Read a wiki page'
  );
  -- the product catalog graph (25-sparql-in-runtime.mdl): the order-free catalog dataset only
  $FindProductTool = call java action MCPServer.AddTool(
    McpServer = $McpServer,
    Name = 'find_product',
    Description = 'Finds products by SKU or by words in the name (e.g. EB-200, battery, charger): SKU, name, type, price, warranty, supplier and, for bikes, the components it ships with.',
    ExecutingMicroflow = 'ServiceDesk.Tool_Product_Find',
    Schema = '{"type": "object", "properties": {"Search": {"type": "string", "description": "A SKU or words from the name"}}, "required": ["Search"]}',
    Title = 'Find a product'
  );
  $CompatibleTool = call java action MCPServer.AddTool(
    McpServer = $McpServer,
    Name = 'compatible_parts',
    Description = 'For a bike: the parts and accessories that fit it. For a part or accessory: what it fits on or works with.',
    ExecutingMicroflow = 'ServiceDesk.Tool_Product_CompatibleParts',
    Schema = '{"type": "object", "properties": {"Sku": {"type": "string", "description": "A SKU, e.g. EB-200 or CHG-4A"}}, "required": ["Sku"]}',
    Title = 'Compatible parts'
  );
  $IssuesTool = call java action MCPServer.AddTool(
    McpServer = $McpServer,
    Name = 'known_issues',
    Description = 'Known issues and recalls for a product, including those on the components a bike ships with. A recall only applies to the production batch it names.',
    ExecutingMicroflow = 'ServiceDesk.Tool_Product_KnownIssues',
    Schema = '{"type": "object", "properties": {"Sku": {"type": "string", "description": "A SKU, e.g. BAT-418"}}, "required": ["Sku"]}',
    Title = 'Known issues and recalls'
  );
  $OutlineTool = call java action MCPServer.AddTool(
    McpServer = $McpServer,
    Name = 'product_outline',
    Description = 'A product as an outline card (JSON): price, warranty, supplier, what it ships with, what fits it or what it fits on, and its known issues and recalls.',
    ExecutingMicroflow = 'ServiceDesk.Tool_Product_Outline',
    Schema = '{"type": "object", "properties": {"Sku": {"type": "string", "description": "A SKU, e.g. EB-200"}}, "required": ["Sku"]}',
    Title = 'Product outline'
  );
  $SparqlTool = call java action MCPServer.AddTool(
    McpServer = $McpServer,
    Name = 'sparql_query',
    Description = 'A read-only SPARQL SELECT or ASK on the product catalog graph (products, suppliers, known issues and recalls, wiki pages; no orders), at most 50 rows. Prefixes shop:, rdf:, rdfs: and xsd: are predeclared.',
    ExecutingMicroflow = 'ServiceDesk.Tool_Product_Sparql',
    Schema = '{"type": "object", "properties": {"Query": {"type": "string", "description": "A SPARQL SELECT or ASK query"}}, "required": ["Query"]}',
    Title = 'SPARQL on the product catalog'
  );
  $WikiProposeTool = call java action MCPServer.AddTool(
    McpServer = $McpServer,
    Name = 'wiki_propose_edit',
    Description = 'Support staff only: proposes a new page or a whole new version of a page. A support agent reviews it in the app before it is published; nothing changes until then.',
    ExecutingMicroflow = 'ServiceDesk.MCPTool_WikiProposeEdit',
    Schema = '{"type": "object", "properties": {"Slug": {"type": "string", "description": "Lowercase words joined by hyphens; an existing slug to change that page"}, "Title": {"type": "string"}, "Summary": {"type": "string", "description": "One sentence: what the page answers"}, "Body": {"type": "string", "description": "The whole page in markdown; link other pages with [[slug]]"}, "Reason": {"type": "string", "description": "What is new or changed, and why"}}, "required": ["Slug", "Title", "Summary", "Body", "Reason"]}',
    Title = 'Propose a wiki edit'
  );
  $Arguments = create list of MCPServer.PromptArgument;
  call microflow MCPServer.PopulatePromptArgList(PromptArgumentList = $Arguments, Name = 'TicketNumber', Description = 'The ticket number, e.g. 1003', Required = true);
  $Prompt = call java action MCPServer.AddPrompt(
    McpServer = $McpServer,
    Name = 'ticket_reply',
    Description = 'Draft a reply to the customer for one support ticket.',
    Parameters = $Arguments,
    Microflow = 'ServiceDesk.MCPPrompt_TicketReply'
  );
  $WikiArguments = create list of MCPServer.PromptArgument;
  call microflow MCPServer.PopulatePromptArgList(PromptArgumentList = $WikiArguments, Name = 'Question', Description = 'The question to answer from the wiki', Required = true);
  $WikiPrompt = call java action MCPServer.AddPrompt(
    McpServer = $McpServer,
    Name = 'wiki_answer',
    Description = 'Answer a question from the service desk wiki: starts with the wiki index and says how to use the wiki tools.',
    Parameters = $WikiArguments,
    Microflow = 'ServiceDesk.MCPPrompt_WikiAnswer'
  );
end;

/** Starts both MCP servers and registers their tools and prompt: /servicedesk/mcp with app-account headers, and /servicedesk-oauth/mcp with OAuth bearer tokens from the issuer in OAuthIssuerUrl. Called from the after-startup microflow; a failure is logged and does not stop the app from starting. */
create or modify microflow "ServiceDesk"."MCP_Initialize" ()
returns Boolean as $Started
folder 'MCP'
begin
  $McpServer = call java action MCPServer.CreateMCPServer(
    Path = 'servicedesk',
    Name = 'ServiceDesk',
    Version = '1.0.0',
    ProtocolVersion = MCPServer.ENUM_ProtocolVersion.v2025_03_26,
    AuthenticationMicroflow = 'ServiceDesk.MCP_Authenticate',
    AuthorizationServerUrl = empty,
    Scopes = empty
  ) on error without rollback begin
    log warning node 'ServiceDesk' 'MCP server not started: {1}. A local run needs --runtime-setting ApplicationRootUrl=http://localhost:8080/ (mxcli run --local ignores the stock root URL).' with ({1} = $latestError/Message);
    return false;
  end error;
  call microflow "ServiceDesk"."SUB_MCP_RegisterTools" (McpServer = $McpServer);
  $OAuthServer = call java action MCPServer.CreateMCPServer(
    Path = 'servicedesk-oauth',
    Name = 'ServiceDeskOAuth',
    Version = '1.0.0',
    ProtocolVersion = MCPServer.ENUM_ProtocolVersion.v2025_03_26,
    AuthenticationMicroflow = 'ServiceDesk.MCP_Authenticate_OAuth',
    AuthorizationServerUrl = @ServiceDesk.OAuthIssuerUrl,
    Scopes = @ServiceDesk.OAuthRequiredScope
  ) on error without rollback begin
    log warning node 'ServiceDesk' 'OAuth MCP server not started: {1}' with ({1} = $latestError/Message);
    return false;
  end error;
  call microflow "ServiceDesk"."SUB_MCP_RegisterTools" (McpServer = $OAuthServer);
  return true;
end;

-- ASU_App (the after-startup microflow) and its registration live in 99-app-shell.mdl.
