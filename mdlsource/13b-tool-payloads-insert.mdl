mdl 1;

-- Places the staff tool-call payload list (ServiceDesk.DS_MessageToolPayloads,
-- 13-chat-rich-text.mdl) in Conversational UI's message snippet, right under the
-- tool calls.
--
-- RUN ONCE, and again only after Conversational UI is updated (which restores
-- the snippet). ALTER has no insert-if-missing (ako/mxcli#1840), so a second run
-- refuses with "duplicate widget name 'lvToolPayloads'" and changes nothing.
-- Every other script here can be run any number of times.

alter snippet ConversationalUI.Snippet_Message_Content {
  insert after listView1 {
    listview lvToolPayloads (
      DataSource: microflow "ServiceDesk"."DS_MessageToolPayloads"(Message = $Message),
      Class: 'listview-hide-on-empty listview-remove-spacing tool-payloads'
    ) {
      pluggablewidget 'com.servicedesk.widgets.chatrichtext.ChatRichText' tpMarkdown (
        stringAttribute: Markdown
      )
    }
  };
};
