mdl 1;

-- Reference details for the chat cards: GET rest/productgraph/v1/nodes/{ref}
-- returns one node of the product graph (a SKU, supplier, issue id or order
-- number) with its facts, from the GraphNode snapshot (14-product-graph-outline.mdl).
-- The ChatRichText widget calls it when a user clicks a reference in a card.
--
-- It authenticates with the user's active session (the widget sends the
-- session's CSRF token) and decides itself what that user may see: a customer
-- gets only their own orders, and no facts that point at other customers' orders.

/** Details of one product graph node, as the reference API returns it. */
create or modify non-persistent entity "ServiceDesk"."GraphNodeDetails" (
  "Ref": String(100),
  "Label": String(1000),
  "Kind": String(100)
);

/** The facts array of GraphNodeDetails (export mappings need a container per array). */
create or modify non-persistent entity "ServiceDesk"."GraphNodeFacts" ();

/** One fact of a graph node. Ref is set when the fact points at another node; Relation, Dir ("out", "in" or "value"), Kind and Target describe that link for the graph views. */
create or modify non-persistent entity "ServiceDesk"."GraphNodeFact" (
  "Label": String(1000),
  "Ref": String(100),
  "Relation": String(200),
  "Dir": String(10),
  "Kind": String(100),
  "Target": String(1000)
);

create or modify association "ServiceDesk"."GraphNodeFacts_GraphNodeDetails"
  from "ServiceDesk"."GraphNodeFacts" to "ServiceDesk"."GraphNodeDetails";

create or modify association "ServiceDesk"."GraphNodeFact_GraphNodeFacts"
  from "ServiceDesk"."GraphNodeFact" to "ServiceDesk"."GraphNodeFacts";

grant read *, write * on entity "ServiceDesk"."GraphNodeDetails" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
grant read *, write * on entity "ServiceDesk"."GraphNodeFacts" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
grant read *, write * on entity "ServiceDesk"."GraphNodeFact" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";

/** The reference API's response body. */
create or modify json structure "ServiceDesk"."JSON_GraphNodeDetails" folder 'Product graph'
  sample '{"ref": "BAT-418", "label": "BAT-418 · Battery 418 Wh", "kind": "Part", "facts": [{"label": "→ supplied by: CellPower GmbH", "ref": "CellPower", "relation": "supplied by", "dir": "out", "kind": "Supplier", "target": "CellPower GmbH"}]}';

create or modify export mapping "ServiceDesk"."EMM_GraphNodeDetails" folder 'Product graph'
  with json structure "ServiceDesk"."JSON_GraphNodeDetails"
{
  "ServiceDesk"."GraphNodeDetails" {
    ref = "Ref",
    label = "Label",
    kind = "Kind",
    "ServiceDesk"."GraphNodeFacts_GraphNodeDetails"/"ServiceDesk"."GraphNodeFacts" as facts {
      "ServiceDesk"."GraphNodeFact_GraphNodeFacts"/"ServiceDesk"."GraphNodeFact" as factsItem {
        label = "Label",
        ref = "Ref",
        relation = "Relation",
        dir = "Dir",
        kind = "Kind",
        target = "Target"
      }
    }
  }
};

/** Whether the current user may see a node that is an order: staff always, a customer only their own. */
create or modify microflow "ServiceDesk"."SUB_GraphNode_MaySeeOrder" ($OrderNumber: String, $Customer: "ServiceDesk"."Customer")
returns Boolean as $MaySee
folder 'Product graph'
begin
  if $Customer = empty then
    return true;
  end if;
  retrieve $Own from "ServiceDesk"."Order" where [OrderNumber = $OrderNumber][ServiceDesk.Order_Customer = $Customer] first;
  return $Own != empty;
end;

/** A graph fact as a link for the graph views: its relation name and direction, parsed from the outline label ("→ supplied by: X", "← has component: Y", "price in EUR: 410.00", "order line: 1 × ..."). */
create or modify microflow "ServiceDesk"."SUB_GraphFact_Describe" ($Fact: "ServiceDesk"."GraphNode")
returns "ServiceDesk"."GraphNodeFact" as $Link
folder 'Product graph'
begin
  declare $Dir String = (if $Fact/Kind = 'inlink' then 'in' else if $Fact/Kind = 'value' then 'value' else 'out');
  declare $Text String = (if startsWith($Fact/Label, '→ ') or startsWith($Fact/Label, '← ') then substring($Fact/Label, 2) else $Fact/Label);
  declare $Colon Integer = find($Text, ': ');
  declare $Relation String = (if $Colon > 0 then substring($Text, 0, $Colon) else if $Fact/Kind = 'inlink' then 'in order' else $Text);
  $Link = create "ServiceDesk"."GraphNodeFact" ("Label" = $Fact/Label, "Relation" = $Relation, "Dir" = $Dir);
  return $Link;
end;

/** REST: product graph nodes whose name or code contains the search text, as the facts of a search result (the same shape as one node). A customer finds no orders but their own. At most 25. */
create or modify microflow "ServiceDesk"."REST_SearchGraphNodes" ($q: String, $httpResponse: System.HttpResponse)
returns "ServiceDesk"."GraphNodeDetails" as $Details
folder 'Product graph'
begin
  declare $Base String = 'https://example.org/bikeshop#';
  declare $OrderClass String = 'https://example.org/bikeshop#Order';
  $IsLoaded = call microflow "ServiceDesk"."SUB_ProductGraph_IsLoaded" ();
  if not($IsLoaded) then
    $Loaded = call microflow "ServiceDesk"."SUB_ProductGraph_Load" ();
  end if;
  $Customer = call microflow "ServiceDesk"."SUB_GetCurrentCustomer" ();
  declare $Query String = trim(if $q = empty then '' else $q);
  $Result = create "ServiceDesk"."GraphNodeDetails" ("Ref" = '', "Label" = 'Search: ' + $Query, "Kind" = 'Search');
  $FactList = create "ServiceDesk"."GraphNodeFacts" ("ServiceDesk"."GraphNodeFacts_GraphNodeDetails" = $Result);
  if length($Query) < 2 then
    return $Result;
  end if;
  retrieve $Matches from "ServiceDesk"."GraphNode" where [Kind = 'resource'][contains(Label, $Query)] sort by "SortKey" asc limit 40;
  retrieve $Classes from "ServiceDesk"."GraphNode" where [Kind = 'class'];
  declare $Shown Integer = 0;
  loop $Match in $Matches begin
    declare $Ref String = substring($Match/NodeKey, length($Base));
    declare $Show Boolean = $Shown < 25;
    if $Show and $Match/ParentKey = $OrderClass then
      $MaySee = call microflow "ServiceDesk"."SUB_GraphNode_MaySeeOrder" (OrderNumber = $Ref, Customer = $Customer);
      set $Show = $MaySee;
    end if;
    if $Show then
      $Class = find $Classes where $currentObject/NodeKey = $Match/ParentKey;
      create "ServiceDesk"."GraphNodeFact" ("Label" = $Match/Label, "Ref" = $Ref, "Relation" = 'match', "Dir" = 'out', "Kind" = (if $Class = empty then '' else $Class/Label), "Target" = $Match/Label, "ServiceDesk"."GraphNodeFact_GraphNodeFacts" = $FactList);
      set $Shown = $Shown + 1;
    end if;
  end loop;
  return $Result;
end;

/** REST: one product graph node and its facts, by reference (the part of its IRI after #). 404 when it does not exist or the user may not see it. */
create or modify microflow "ServiceDesk"."REST_GetGraphNode" ($ref: String, $httpResponse: System.HttpResponse)
returns "ServiceDesk"."GraphNodeDetails" as $Details
folder 'Product graph'
begin
  declare $Base String = 'https://example.org/bikeshop#';
  declare $OrderClass String = 'https://example.org/bikeshop#Order';
  $IsLoaded = call microflow "ServiceDesk"."SUB_ProductGraph_IsLoaded" ();
  if not($IsLoaded) then
    $Loaded = call microflow "ServiceDesk"."SUB_ProductGraph_Load" ();
  end if;
  $Customer = call microflow "ServiceDesk"."SUB_GetCurrentCustomer" ();
  declare $Key String = $Base + $ref;
  retrieve $Node from "ServiceDesk"."GraphNode" where [NodeKey = $Key][Kind = 'resource'] first;
  if $Node = empty then
    change $httpResponse ("StatusCode" = 404);
    return empty;
  end if;
  if $Node/ParentKey = $OrderClass then
    $MaySeeNode = call microflow "ServiceDesk"."SUB_GraphNode_MaySeeOrder" (OrderNumber = $ref, Customer = $Customer);
    if not($MaySeeNode) then
      change $httpResponse ("StatusCode" = 404);
      return empty;
    end if;
  end if;
  retrieve $Class from "ServiceDesk"."GraphNode" where [NodeKey = $Node/ParentKey] first;
  $Result = create "ServiceDesk"."GraphNodeDetails" ("Ref" = $ref, "Label" = $Node/Label, "Kind" = (if $Class = empty then '' else $Class/Label));
  $FactList = create "ServiceDesk"."GraphNodeFacts" ("ServiceDesk"."GraphNodeFacts_GraphNodeDetails" = $Result);
  retrieve $Facts from "ServiceDesk"."GraphNode" where [ParentKey = $Node/NodeKey] sort by "SortKey" asc;
  retrieve $Orders from "ServiceDesk"."GraphNode" where [ParentKey = $OrderClass];
  retrieve $Resources from "ServiceDesk"."GraphNode" where [Kind = 'resource'];
  retrieve $Classes from "ServiceDesk"."GraphNode" where [Kind = 'class'];
  loop $Fact in $Facts begin
    declare $TargetRef String = '';
    declare $Show Boolean = true;
    if $Fact/Detail != empty and startsWith($Fact/Detail, $Base) then
      set $TargetRef = substring($Fact/Detail, length($Base));
      $TargetOrder = find $Orders where $currentObject/NodeKey = $Fact/Detail;
      if $TargetOrder != empty then
        $MaySeeTarget = call microflow "ServiceDesk"."SUB_GraphNode_MaySeeOrder" (OrderNumber = $TargetRef, Customer = $Customer);
        set $Show = $MaySeeTarget;
      end if;
    end if;
    if $Show then
      $Target = find $Resources where $currentObject/NodeKey = $Fact/Detail;
      $TargetClass = find $Classes where $currentObject/NodeKey = (if $Target = empty then '' else $Target/ParentKey);
      $Link = call microflow "ServiceDesk"."SUB_GraphFact_Describe" (Fact = $Fact);
      change $Link (
        "Ref" = $TargetRef,
        "Kind" = (if $TargetClass = empty then '' else $TargetClass/Label),
        "Target" = (if $Target = empty then '' else $Target/Label),
        "ServiceDesk"."GraphNodeFact_GraphNodeFacts" = $FactList
      );
    end if;
  end loop;
  return $Result;
end;

/** Product graph references for the chat cards. Signed-in users only (active session). */
create or modify published rest service "ServiceDesk"."ProductGraphApi" (
  Path: 'rest/productgraph/v1',
  Version: '1.0.0',
  ServiceName: 'Product graph references',
  Authentication: (session)
)
{
  resource 'nodes' {
    get '' microflow "ServiceDesk"."REST_SearchGraphNodes" export mapping "ServiceDesk"."EMM_GraphNodeDetails";
    get '{ref}' microflow "ServiceDesk"."REST_GetGraphNode" export mapping "ServiceDesk"."EMM_GraphNodeDetails";
  }
  resource 'models' {
    get '{ref}' microflow "ServiceDesk"."REST_GetBikeModel";
  }
};

grant execute on microflow "ServiceDesk"."REST_SearchGraphNodes" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
grant execute on microflow "ServiceDesk"."REST_GetGraphNode" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
grant access on published rest service "ServiceDesk"."ProductGraphApi" to "ServiceDesk"."Customer", "ServiceDesk"."SupportAgent", "ServiceDesk"."Admin";
